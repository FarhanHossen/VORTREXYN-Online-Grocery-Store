<%- include('partials/header') %>

<div class="confirmation-page">
  <div class="confirmation-card">
    <div class="confirmation-icon"><i class="fas fa-check-circle"></i></div>
    <h1>Order Confirmed!</h1>
    <p class="confirm-sub">Thank you, <strong><%= name %></strong>! Your order has been placed successfully.</p>
    <p class="email-note"><i class="fas fa-envelope"></i> Confirmation sent to <strong><%= email %></strong></p>

    <div class="confirm-details">
      <h3>Order Summary</h3>
      <div class="detail-grid">
        <div class="detail-item"><span class="detail-label"><i class="fas fa-user"></i> Name</span><span><%= name %></span></div>
        <div class="detail-item"><span class="detail-label"><i class="fas fa-phone"></i> Mobile</span><span><%= mobile %></span></div>
        <div class="detail-item"><span class="detail-label"><i class="fas fa-envelope"></i> Email</span><span><%= email %></span></div>
        <div class="detail-item"><span class="detail-label"><i class="fas fa-map-marker-alt"></i> Address</span><span><%= street %>, <%= city %>, <%= state %></span></div>
        <% if (typeof grandTotal !== 'undefined') { %>
        <div class="detail-item"><span class="detail-label"><i class="fas fa-dollar-sign"></i> Total Paid</span><span style="color:var(--green-dark);font-weight:800">$<%= grandTotal %></span></div>
        <% } %>
      </div>
    </div>

    <% if (!user) { %>
    <div class="guest-signup-prompt">
      <i class="fas fa-star"></i>
      <div>
        <strong>Earn Reward Points!</strong>
        <p>Create an account to earn points on every order and unlock exclusive discounts.</p>
      </div>
      <a href="/auth/signup" class="btn btn-primary">Sign Up Free</a>
    </div>
    <% } else { %>
    <%
      const newTier  = (typeof newTotalPointsEarned !== 'undefined' && newTotalPointsEarned >= 500) ? 2 : 1;
      const justUpgraded = (typeof tier !== 'undefined') && tier === 1 && newTier === 2;
    %>
    <% if (justUpgraded) { %>
    <div class="tier-upgrade-banner">
      <i class="fas fa-star"></i><i class="fas fa-star"></i>
      <div>
        <strong>You reached Tier 2!</strong>
        <p>From now on, every 10 points = <strong>$1.00</strong> discount — double the savings!</p>
      </div>
    </div>
    <% } %>
    <div class="points-earned">
      <% for(let s=0;s<newTier;s++) { %><i class="fas fa-star" style="color:#fbbf24"></i><% } %>
      <div>
        <span>You earned <strong><%= pointsEarned %> reward points</strong> on this order!</span><br>
        <small style="opacity:.8">
          Balance: <strong><%= newRewardPoints %> pts</strong> &nbsp;|&nbsp;
          Tier <strong><%= newTier %></strong>
          (<%= newTier === 2 ? '10 pts = $1.00' : '10 pts = $0.50' %>)
        </small>
        <% if (newTier === 1 && typeof newTotalPointsEarned !== 'undefined') { %>
        <br><small style="opacity:.6"><%= 500 - newTotalPointsEarned %> more pts earned to reach Tier 2</small>
        <% } %>
      </div>
    </div>
    <% } %>

    <div class="checkout-steps centered">
      <div class="step done"><i class="fas fa-shopping-cart"></i><span>Cart</span></div>
      <div class="step-line done"></div>
      <div class="step done"><i class="fas fa-map-marker-alt"></i><span>Delivery</span></div>
      <div class="step-line done"></div>
      <div class="step done"><i class="fas fa-credit-card"></i><span>Payment</span></div>
      <div class="step-line done"></div>
      <div class="step done active"><i class="fas fa-check-circle"></i><span>Done</span></div>
    </div>

    <div class="confirm-actions">
      <a href="/" class="btn btn-primary"><i class="fas fa-home"></i> Back to Home</a>
      <a href="/products" class="btn btn-outline"><i class="fas fa-shopping-basket"></i> Shop Again</a>
    </div>
  </div>
</div>

<% if (user && newRewardPoints !== null) { %>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
<script src="/js/firebase-init.js"></script>
<script>
  // Write updated reward points & order count back to Firestore
  (async () => {
    try {
      await firebase.auth().signInAnonymously().catch(() => {});
      const db  = firebase.firestore();
      const uid = '<%= user.uid %>';
      await db.collection('users').doc(uid).set({
        rewardPoints:      <%= newRewardPoints %>,
        totalOrders:       <%= newTotalOrders %>,
        totalPointsEarned: <%= newTotalPointsEarned || 0 %>,
        lastOrderAt:       firebase.firestore.FieldValue.serverTimestamp(),
      }, { merge: true });
      console.log('Reward points saved to Firestore:', <%= newRewardPoints %>);
    } catch (e) {
      console.warn('Firestore update skipped:', e.message);
    }
  })();
</script>
<% } %>

<%- include('partials/footer') %>

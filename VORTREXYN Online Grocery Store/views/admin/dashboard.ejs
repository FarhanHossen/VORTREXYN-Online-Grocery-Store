<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Admin Dashboard — VORTREXYN</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:#070503;min-height:100vh;font-family:Inter,sans-serif;color:#f0e6d3}
    /* ── Sidebar ── */
    .sidebar{position:fixed;top:0;left:0;width:230px;height:100vh;background:#0d0b06;border-right:1px solid #2a1f0a;display:flex;flex-direction:column;z-index:100}
    .sidebar-brand{padding:24px 22px 20px;border-bottom:1px solid #2a1f0a}
    .sidebar-brand svg{display:block;width:100%;height:auto}
    .sbbadge{animation:sbPop .45s cubic-bezier(.34,1.56,.64,1) both}
    .sbring{stroke-dasharray:138;stroke-dashoffset:138;animation:sbDraw .65s ease-out .12s both}
    .sbinner{stroke-dasharray:115;stroke-dashoffset:115;animation:sbDraw .5s ease-out .38s both}
    .sbs1{stroke-dasharray:20;stroke-dashoffset:20;animation:sbSpoke .28s ease .5s both}
    .sbs2{stroke-dasharray:20;stroke-dashoffset:20;animation:sbSpoke .28s ease .59s both}
    .sbs3{stroke-dasharray:20;stroke-dashoffset:20;animation:sbSpoke .28s ease .68s both}
    .sbs4{stroke-dasharray:20;stroke-dashoffset:20;animation:sbSpoke .28s ease .77s both}
    .sbs5{stroke-dasharray:20;stroke-dashoffset:20;animation:sbSpoke .28s ease .86s both}
    .sbs6{stroke-dasharray:20;stroke-dashoffset:20;animation:sbSpoke .28s ease .95s both}
    .sbvl{stroke-dasharray:24;stroke-dashoffset:24;animation:sbVdraw .44s ease 1.12s both}
    .sbvr{stroke-dasharray:24;stroke-dashoffset:24;animation:sbVdraw .44s ease 1.28s both}
    .sbvcl{transform-box:fill-box;transform-origin:center;animation:sbPop .2s cubic-bezier(.34,1.56,.64,1) 1.44s both}
    .sbvcr{transform-box:fill-box;transform-origin:center;animation:sbPop .2s cubic-bezier(.34,1.56,.64,1) 1.52s both}
    .sbva{transform-box:fill-box;transform-origin:center;animation:sbPop .24s cubic-bezier(.34,1.56,.64,1) 1.6s both,sbPulse 2.2s ease-in-out 2.1s infinite}
    .sbt1{opacity:0;animation:sbSlide .4s ease .3s forwards}
    .sbt2{opacity:0;animation:sbSlide .4s ease .5s forwards}
    @keyframes sbPop{0%{opacity:0;transform:scale(0)}100%{opacity:1;transform:scale(1)}}
    @keyframes sbDraw{to{stroke-dashoffset:0}}
    @keyframes sbSpoke{0%{stroke-dashoffset:20;opacity:0}100%{stroke-dashoffset:0;opacity:1}}
    @keyframes sbVdraw{0%{stroke-dashoffset:24;opacity:0}100%{stroke-dashoffset:0;opacity:1}}
    @keyframes sbPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(1.7)}}
    @keyframes sbSlide{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
    .sidebar-nav{padding:20px 12px;flex:1}
    .sidebar-nav a{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;color:#a8956e;font-size:13px;font-weight:600;text-decoration:none;margin-bottom:2px;transition:all .2s}
    .sidebar-nav a:hover,.sidebar-nav a.active{background:rgba(245,158,11,.1);color:#f59e0b}
    .sidebar-nav a i{width:16px;text-align:center;font-size:13px}
    .sidebar-footer{padding:16px 12px;border-top:1px solid #2a1f0a}
    .sidebar-footer form button{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;color:#a8956e;font-size:13px;font-weight:600;background:none;border:none;cursor:pointer;width:100%;transition:all .2s}
    .sidebar-footer form button:hover{background:rgba(239,68,68,.1);color:#f87171}
    /* ── Main ── */
    .main{margin-left:230px;padding:32px}
    .topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:32px}
    .topbar h1{font-family:'Playfair Display',serif;font-size:24px;font-weight:800;color:#f0e6d3}
    .topbar .admin-badge{background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25);color:#f59e0b;font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:5px 12px;border-radius:4px}
    /* ── Stat cards ── */
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:32px}
    .stat-card{background:#0d0b06;border:1px solid #2a1f0a;border-radius:12px;padding:22px 24px;display:flex;align-items:center;gap:18px}
    .stat-icon{width:48px;height:48px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
    .stat-icon.amber{background:rgba(245,158,11,.12);color:#f59e0b}
    .stat-icon.orange{background:rgba(249,115,22,.12);color:#fb923c}
    .stat-icon.red{background:rgba(239,68,68,.12);color:#f87171}
    .stat-label{font-size:11px;font-weight:700;color:#a8956e;letter-spacing:2px;text-transform:uppercase;margin-bottom:4px}
    .stat-value{font-size:28px;font-weight:800;color:#f0e6d3}
    /* ── Alerts ── */
    .alert{padding:12px 16px;border-radius:8px;font-size:13px;font-weight:600;margin-bottom:24px;display:flex;align-items:center;gap:8px}
    .alert.success{background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.25);color:#86efac}
    .alert.danger{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.25);color:#f87171}
    /* ── Section ── */
    .section{background:#0d0b06;border:1px solid #2a1f0a;border-radius:12px;margin-bottom:28px;overflow:hidden}
    .section-head{padding:18px 24px;border-bottom:1px solid #2a1f0a;display:flex;align-items:center;justify-content:space-between}
    .section-head h2{font-size:14px;font-weight:700;color:#f0e6d3;display:flex;align-items:center;gap:9px}
    .section-head h2 i{color:#f59e0b}
    /* ── Add product form ── */
    .add-form{padding:22px 24px;border-bottom:1px solid #2a1f0a;display:none}
    .add-form.open{display:block}
    .form-row{display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:12px;align-items:end}
    .fg label{font-size:10px;font-weight:700;color:#a8956e;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:6px;display:block}
    .fg input{width:100%;background:#131009;border:1px solid #2a1f0a;border-radius:6px;padding:9px 12px;color:#f0e6d3;font-size:13px;font-family:Inter,sans-serif}
    .fg input:focus{outline:none;border-color:#f59e0b;background:#1a1200}
    .fg input::placeholder{color:#4a3a20}
    /* ── Table ── */
    .tbl-wrap{overflow-x:auto}
    table{width:100%;border-collapse:collapse}
    thead tr{background:#131009}
    th{padding:11px 16px;text-align:left;font-size:10px;font-weight:700;color:#a8956e;letter-spacing:1.5px;text-transform:uppercase;white-space:nowrap}
    tbody tr{border-top:1px solid #1a1200;transition:background .15s}
    tbody tr:hover{background:#131009}
    td{padding:10px 16px;font-size:13px;color:#f0e6d3;vertical-align:middle}
    .prod-thumb{width:44px;height:44px;border-radius:8px;object-fit:cover;background:#1a1200;border:1px solid #2a1f0a}
    .prod-code{display:inline-block;background:#1a1200;border:1px solid #2a1f0a;color:#f59e0b;font-size:11px;font-weight:700;font-family:monospace;letter-spacing:.5px;padding:3px 8px;border-radius:4px}
    .alert.info{background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.25);color:#93c5fd}
    /* ── Generating overlay ── */
    .gen-overlay{display:none;position:fixed;inset:0;background:rgba(7,5,3,.88);z-index:500;flex-direction:column;align-items:center;justify-content:center;gap:20px}
    .gen-overlay.active{display:flex}
    .gen-spinner{width:56px;height:56px;border:4px solid rgba(245,158,11,.15);border-top-color:#f59e0b;border-radius:50%;animation:spin .8s linear infinite}
    .gen-title{font-size:18px;font-weight:700;color:#f0e6d3;font-family:'Playfair Display',serif}
    .gen-sub{font-size:13px;color:#a8956e;text-align:center;max-width:300px;line-height:1.6}
    @keyframes spin{to{transform:rotate(360deg)}}
    .badge-stock{font-size:11px;font-weight:700;padding:3px 9px;border-radius:4px}
    .badge-stock.ok{background:rgba(34,197,94,.1);color:#86efac;border:1px solid rgba(34,197,94,.2)}
    .badge-stock.low{background:rgba(249,115,22,.1);color:#fb923c;border:1px solid rgba(249,115,22,.2)}
    .badge-stock.out{background:rgba(239,68,68,.1);color:#f87171;border:1px solid rgba(239,68,68,.2)}
    .tier-badge{font-size:11px;font-weight:700;padding:3px 9px;border-radius:4px;letter-spacing:.5px}
    .tier-1{background:rgba(156,163,175,.12);color:#9ca3af;border:1px solid rgba(156,163,175,.2)}
    .tier-2{background:rgba(180,83,9,.12);color:#d97706;border:1px solid rgba(180,83,9,.25)}
    .tier-3{background:rgba(148,163,184,.12);color:#cbd5e1;border:1px solid rgba(148,163,184,.25)}
    .tier-4{background:rgba(245,158,11,.12);color:#fbbf24;border:1px solid rgba(245,158,11,.3)}
    .tier-5{background:rgba(99,102,241,.12);color:#818cf8;border:1px solid rgba(99,102,241,.25)}
    .tier-6{background:rgba(20,184,166,.12);color:#2dd4bf;border:1px solid rgba(20,184,166,.25)}
    .tier-7{background:rgba(251,113,133,.12);color:#fb7185;border:1px solid rgba(251,113,133,.25)}
    .stats{grid-template-columns:repeat(4,1fr)}
    /* ── Buttons ── */
    .btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;border:none;transition:all .2s;text-decoration:none;letter-spacing:.5px}
    .btn-amber{background:#f59e0b;color:#070503}
    .btn-amber:hover{background:#fbbf24}
    .btn-outline{background:none;border:1px solid #2a1f0a;color:#a8956e}
    .btn-outline:hover{border-color:#f59e0b;color:#f59e0b}
    .btn-ghost-red{background:none;border:1px solid rgba(239,68,68,.25);color:#f87171;font-size:11px;padding:5px 10px}
    .btn-ghost-red:hover{background:rgba(239,68,68,.1)}
    .btn-ghost-edit{background:none;border:1px solid rgba(245,158,11,.2);color:#f59e0b;font-size:11px;padding:5px 10px}
    .btn-ghost-edit:hover{background:rgba(245,158,11,.1)}
    /* ── Modals ── */
    .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;align-items:center;justify-content:center}
    .modal-overlay.open{display:flex}
    .modal{background:#0d0b06;border:1px solid #2a1f0a;border-radius:14px;padding:32px;width:100%;max-width:480px}
    .modal h3{font-size:16px;font-weight:700;color:#f0e6d3;margin-bottom:20px;display:flex;align-items:center;gap:9px}
    .modal h3 i{color:#f59e0b}
    .modal-fields{display:grid;gap:14px}
    .modal-actions{display:flex;gap:10px;margin-top:22px;justify-content:flex-end}
    .mfg label{font-size:10px;font-weight:700;color:#a8956e;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:6px;display:block}
    .mfg input{width:100%;background:#131009;border:1px solid #2a1f0a;border-radius:6px;padding:9px 12px;color:#f0e6d3;font-size:13px;font-family:Inter,sans-serif}
    .mfg input:focus{outline:none;border-color:#f59e0b;background:#1a1200}
  </style>
</head>
<body>

<!-- ── Sidebar ── -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 270 52" aria-label="VORTREXYN Online Grocery Store">
      <defs>
        <linearGradient id="sbbg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#1a1008"/><stop offset="100%" stop-color="#080503"/>
        </linearGradient>
        <radialGradient id="sbglow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity=".2"/><stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="sbvglow" cx="50%" cy="72%" r="55%">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity=".3"/><stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
        </radialGradient>
        <filter id="sbvf" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="1.6" result="b"/>
          <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <polygon class="sbbadge" points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="url(#sbbg)"/>
      <polygon points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="url(#sbglow)"/>
      <polygon class="sbring" points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="none" stroke="#f59e0b" stroke-width="1" stroke-opacity=".45" stroke-linejoin="round"/>
      <polygon class="sbinner" points="26,12 38.1,19 38.1,33 26,40 13.9,33 13.9,19" fill="none" stroke="#f59e0b" stroke-width=".65" stroke-opacity=".2" stroke-linejoin="round"/>
      <line class="sbs1" x1="26" y1="26" x2="36" y2="8.75"  stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
      <line class="sbs2" x1="26" y1="26" x2="45.9" y2="26"  stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
      <line class="sbs3" x1="26" y1="26" x2="36" y2="43.25" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" opacity=".55"/>
      <line class="sbs4" x1="26" y1="26" x2="16" y2="43.25" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" opacity=".55"/>
      <line class="sbs5" x1="26" y1="26" x2="6.1" y2="26"   stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
      <line class="sbs6" x1="26" y1="26" x2="16" y2="8.75"  stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
      <polygon points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="url(#sbvglow)" class="sbvl" style="animation:sbVdraw .44s ease 1.12s both;stroke:none"/>
      <g filter="url(#sbvf)" opacity=".5" class="sbvl">
        <line x1="17" y1="14" x2="26" y2="36" stroke="#f59e0b" stroke-width="4" stroke-linecap="round"/>
        <line x1="35" y1="14" x2="26" y2="36" stroke="#f59e0b" stroke-width="4" stroke-linecap="round"/>
      </g>
      <line class="sbvl" x1="17" y1="14" x2="26" y2="36" stroke="#fcd34d" stroke-width="2.6" stroke-linecap="round"/>
      <line class="sbvr" x1="35" y1="14" x2="26" y2="36" stroke="#fcd34d" stroke-width="2.6" stroke-linecap="round"/>
      <circle class="sbvcl" cx="17" cy="14" r="1.6" fill="#d97706"/>
      <circle class="sbvcr" cx="35" cy="14" r="1.6" fill="#d97706"/>
      <circle class="sbva"  cx="26" cy="36" r="2.2" fill="#fef3c7"/>
      <text class="sbt1" x="60" y="23" font-family="Inter,sans-serif" font-size="17" font-weight="800" fill="white" letter-spacing="2">VORTREXYN</text>
      <text class="sbt2" x="61" y="39" font-family="Inter,sans-serif" font-size="9.5" font-weight="500" fill="rgba(255,255,255,0.55)" letter-spacing="1">Online Grocery Store</text>
    </svg>
  </div>
  <nav class="sidebar-nav">
    <a href="/admin" class="active"><i class="fas fa-th-large"></i> Dashboard</a>
    <a href="#users-section" onclick="document.getElementById('users-section').scrollIntoView({behavior:'smooth'});return false;"><i class="fas fa-users"></i> Users</a>
    <a href="/products" target="_blank"><i class="fas fa-store"></i> View Store</a>
  </nav>
  <div class="sidebar-footer">
    <form action="/admin/logout" method="POST">
      <button type="submit"><i class="fas fa-sign-out-alt"></i> Sign Out</button>
    </form>
  </div>
</aside>

<!-- ── Main content ── -->
<main class="main">

  <div class="topbar">
    <h1>Dashboard</h1>
    <span class="admin-badge"><i class="fas fa-shield-alt" style="margin-right:6px"></i>Admin</span>
  </div>

  <% if (saved) { %>
    <div class="alert success"><i class="fas fa-check-circle"></i> Product added successfully — AI image generated and ready.</div>
  <% } %>
  <% if (deleted) { %>
    <div class="alert danger"><i class="fas fa-trash-alt"></i> Product deleted.</div>
  <% } %>
  <% if (userDeleted) { %>
    <div class="alert danger"><i class="fas fa-user-times"></i> User account deleted.</div>
  <% } %>

  <!-- Stats -->
  <div class="stats">
    <div class="stat-card">
      <div class="stat-icon amber"><i class="fas fa-boxes"></i></div>
      <div>
        <div class="stat-label">Total Products</div>
        <div class="stat-value"><%= totalProducts %></div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon orange"><i class="fas fa-exclamation-triangle"></i></div>
      <div>
        <div class="stat-label">Low Stock</div>
        <div class="stat-value"><%= lowStock %></div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon red"><i class="fas fa-times-circle"></i></div>
      <div>
        <div class="stat-label">Out of Stock</div>
        <div class="stat-value"><%= outOfStock %></div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(139,92,246,.12);color:#a78bfa"><i class="fas fa-users"></i></div>
      <div>
        <div class="stat-label">Registered Users</div>
        <div class="stat-value"><%= totalUsers %></div>
      </div>
    </div>
  </div>

  <!-- Products section -->
  <div class="section">
    <div class="section-head">
      <h2><i class="fas fa-box-open"></i> Product Management</h2>
      <button class="btn btn-amber" onclick="toggleAddForm()">
        <i class="fas fa-plus"></i> Add Product
      </button>
    </div>

    <!-- Add product form -->
    <div class="add-form" id="addForm">
      <form action="/admin/product/add" method="POST" id="addProductForm">
        <div class="form-row">
          <div class="fg">
            <label>Product Name</label>
            <input type="text" name="product_name" placeholder="e.g. Organic Apples" required>
          </div>
          <div class="fg">
            <label>Price ($)</label>
            <input type="number" name="unit_price" placeholder="0.00" step="0.01" min="0" required>
          </div>
          <div class="fg">
            <label>Unit / Qty</label>
            <input type="text" name="unit_quantity" placeholder="e.g. 1kg" required>
          </div>
          <div class="fg">
            <label>In Stock</label>
            <input type="number" name="in_stock" placeholder="0" min="0" required>
          </div>
          <div class="fg" style="display:flex;gap:8px">
            <button type="submit" class="btn btn-amber"><i class="fas fa-save"></i> Save</button>
            <button type="button" class="btn btn-outline" onclick="toggleAddForm()">Cancel</button>
          </div>
        </div>
      </form>
    </div>

    <!-- Products table -->
    <div class="tbl-wrap">
      <table>
        <thead>
          <tr>
            <th>Image</th>
            <th>Product Code</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Unit</th>
            <th>Stock</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(p) {
            const imgMap = {
              1000:'fish-fingers.png',1001:'fish-fingers.png',1002:'hamburger-patties.png',1003:'shelled-prawns.png',
              1004:'ice-cream.png',1005:'ice-cream.png',1006:'frozen-peas.png',1007:'frozen-vegetables.png',1008:'frozen-pizza.png',
              2000:'panadol.png',2001:'panadol.png',2002:'bath-soap.png',2003:'garbage-bags.png',2004:'garbage-bags.png',
              2005:'washing-powder.png',2006:'laundry-bleach.png',2007:'shampoo.png',2008:'toothpaste.png',
              2009:'hand-sanitizer.png',2010:'dish-soap.png',2011:'paper-towels.png',2012:'toilet-paper.png',
              3000:'cheddar-cheese.png',3001:'cheddar-cheese.png',3002:'tbone-steak.png',3003:'navel-oranges.png',
              3004:'bananas.png',3005:'peaches.png',3006:'grapes.png',3007:'apples.png',3008:'milk.png',3009:'eggs.png',
              3010:'butter.png',3011:'greek-yogurt.png',3012:'chicken-breast.png',3013:'lamb-chops.png',
              3014:'strawberries.png',3015:'watermelon.png',3016:'mangoes.png',3017:'lemons.png',
              4000:'earl-grey-tea.png',4001:'earl-grey-tea.png',4002:'earl-grey-tea.png',4003:'instant-coffee.png',
              4004:'instant-coffee.png',4005:'chocolate-bar.png',4006:'orange-juice.png',4007:'apple-juice.png',
              4008:'sparkling-water.png',4009:'green-tea.png',4010:'potato-chips.png',4011:'mixed-nuts.png',
              4012:'popcorn.png',4013:'crackers.png',
              5000:'dry-dog-food.png',5001:'dry-dog-food.png',5002:'bird-food.png',5003:'cat-food.png',
              5004:'fish-food.png',5005:'wet-cat-food.png',5006:'dog-treats.png',
              6000:'white-bread.png',6001:'wholegrain-bread.png',6002:'croissants.png',6003:'muffins.png',
              6004:'dinner-rolls.png',6005:'sourdough.png',
              7000:'carrots.png',7001:'broccoli.png',7002:'potatoes.png',7003:'tomatoes.png',7004:'onions.png',
              7005:'capsicum.png',7006:'spinach.png',7007:'mushrooms.png',
              8000:'rice.png',8001:'pasta.png',8002:'flour.png',8003:'sugar.png',8004:'canned-tomatoes.png',
              8005:'tomato-sauce.png',8006:'olive-oil.png',8007:'soy-sauce.png',
              9000:'ham-slices.png',9001:'salami.png',9002:'hummus.png',9003:'cheese-slices.png'
            };
            const imgFile = imgMap[p.product_id] || p.image_filename || 'product-placeholder.png';
            const imgSrc  = imgFile.startsWith('http') ? imgFile : '/images/' + imgFile;
          %>
          <tr>
            <td><img src="<%= imgSrc %>" alt="<%= p.product_name %>" class="prod-thumb" onerror="this.src='/images/product-placeholder.png'"></td>
            <td><span class="prod-code"><%= p.product_id %></span></td>
            <td style="font-weight:600"><%= p.product_name %></td>
            <td style="color:#f59e0b;font-weight:700">$<%= parseFloat(p.unit_price).toFixed(2) %></td>
            <td style="color:#a8956e"><%= p.unit_quantity %></td>
            <td><%= p.in_stock %></td>
            <td>
              <% if (parseInt(p.in_stock) === 0) { %>
                <span class="badge-stock out">Out of Stock</span>
              <% } else if (parseInt(p.in_stock) <= 5) { %>
                <span class="badge-stock low">Low Stock</span>
              <% } else { %>
                <span class="badge-stock ok">In Stock</span>
              <% } %>
            </td>
            <td style="display:flex;gap:8px;align-items:center">
              <button class="btn btn-ghost-edit" onclick='openEdit(<%= JSON.stringify(p) %>)'>
                <i class="fas fa-pencil-alt"></i> Edit
              </button>
              <button class="btn btn-ghost-red" onclick='confirmDelete(<%= p.product_id || 0 %>, "<%= p.product_name.replace(/"/g,"&quot;").replace(/'/g,"&#39;") %>")'>
                <i class="fas fa-trash"></i> Delete
              </button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Users section -->
  <div class="section" id="users-section">
    <div class="section-head">
      <h2><i class="fas fa-users"></i> User Management</h2>
      <span style="font-size:11px;color:#a8956e;font-weight:600;letter-spacing:1px"><%= totalUsers %> registered</span>
    </div>
    <div class="tbl-wrap">
      <% if (users.length === 0) { %>
        <div style="padding:32px 24px;text-align:center;color:#4a3a20;font-size:13px">No registered users found.</div>
      <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Contact</th>
            <th>Tier</th>
            <th>Joined</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
          <tr>
            <td style="font-weight:600"><%= u.name %></td>
            <td style="color:#a8956e"><%= u.email %></td>
            <td><%= u.contact %></td>
            <td>
              <span class="tier-badge tier-<%= u.tier %>"><%= u.tierName %></span>
            </td>
            <td style="color:#4a3a20;font-size:12px"><%= u.joined %></td>
            <td>
              <button class="btn btn-ghost-red" onclick='confirmDeleteUser("<%= u.uid %>", "<%= u.name.replace(/"/g,"&quot;").replace(/'/g,"&#39;") %>", "<%= u.email %>")'>
                <i class="fas fa-user-times"></i> Delete
              </button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

</main>

<!-- Generating overlay -->
<div class="gen-overlay" id="genOverlay">
  <div class="gen-spinner"></div>
  <div class="gen-title">Generating AI Image…</div>
  <div class="gen-sub" id="genSubText">Creating a product photo — this takes about 15 seconds. Please wait.</div>
</div>

<!-- Delete confirmation modal -->
<div class="modal-overlay" id="deleteModal">
  <div class="modal" style="max-width:380px">
    <h3><i class="fas fa-trash-alt" style="color:#f87171"></i> Delete Product</h3>
    <p style="font-size:14px;color:#a8956e;margin-bottom:6px">Are you sure you want to delete:</p>
    <p style="font-size:15px;font-weight:700;color:#f0e6d3;margin-bottom:22px" id="deleteProductName"></p>
    <form action="/admin/product/delete" method="POST" id="deleteForm">
      <input type="hidden" name="product_id" id="deleteProductId">
      <div style="display:flex;gap:10px;justify-content:flex-end">
        <button type="button" class="btn btn-outline" onclick="closeDelete()">Cancel</button>
        <button type="submit" class="btn" style="background:#ef4444;color:#fff"><i class="fas fa-trash"></i> Yes, Delete</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete user modal -->
<div class="modal-overlay" id="deleteUserModal">
  <div class="modal" style="max-width:400px">
    <h3><i class="fas fa-user-times" style="color:#f87171"></i> Delete User</h3>
    <p style="font-size:14px;color:#a8956e;margin-bottom:6px">You are about to permanently delete:</p>
    <p style="font-size:15px;font-weight:700;color:#f0e6d3;margin-bottom:4px" id="deleteUserName"></p>
    <p style="font-size:12px;color:#4a3a20;margin-bottom:22px" id="deleteUserEmail"></p>
    <p style="font-size:12px;color:#f87171;margin-bottom:22px">This will remove their account and all profile data. This cannot be undone.</p>
    <form action="/admin/user/delete" method="POST" id="deleteUserForm">
      <input type="hidden" name="uid" id="deleteUserUid">
      <div style="display:flex;gap:10px;justify-content:flex-end">
        <button type="button" class="btn btn-outline" onclick="closeDeleteUser()">Cancel</button>
        <button type="submit" class="btn" style="background:#ef4444;color:#fff"><i class="fas fa-user-times"></i> Yes, Delete</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit modal -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <h3><i class="fas fa-pencil-alt"></i> Edit Product</h3>
    <form action="/admin/product/edit" method="POST">
      <input type="hidden" name="product_id" id="edit_id">
      <div class="modal-fields">
        <div class="mfg">
          <label>Product Name</label>
          <input type="text" name="product_name" id="edit_name" required>
        </div>
        <div class="mfg">
          <label>Price ($)</label>
          <input type="number" name="unit_price" id="edit_price" step="0.01" min="0" required>
        </div>
        <div class="mfg">
          <label>Unit / Quantity</label>
          <input type="text" name="unit_quantity" id="edit_unit" required>
        </div>
        <div class="mfg">
          <label>In Stock</label>
          <input type="number" name="in_stock" id="edit_stock" min="0" required>
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-outline" onclick="closeEdit()">Cancel</button>
        <button type="submit" class="btn btn-amber"><i class="fas fa-save"></i> Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
function toggleAddForm() {
  const f = document.getElementById('addForm');
  f.classList.toggle('open');
}
document.getElementById('addProductForm').addEventListener('submit', function() {
  const name = this.querySelector('[name="product_name"]').value.trim() || 'product';
  document.getElementById('genSubText').textContent =
    'Generating a photo for "' + name + '" — this takes about 15 seconds. Please wait.';
  document.getElementById('genOverlay').classList.add('active');
  const btn = this.querySelector('button[type="submit"]');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating…';
});
function confirmDelete(id, name) {
  document.getElementById('deleteProductId').value = id;
  document.getElementById('deleteProductName').textContent = name;
  document.getElementById('deleteModal').classList.add('open');
}
function closeDelete() {
  document.getElementById('deleteModal').classList.remove('open');
}
document.getElementById('deleteModal').addEventListener('click', function(e) {
  if (e.target === this) closeDelete();
});
function openEdit(p) {
  document.getElementById('edit_id').value    = p.product_id;
  document.getElementById('edit_name').value  = p.product_name;
  document.getElementById('edit_price').value = p.unit_price;
  document.getElementById('edit_unit').value  = p.unit_quantity;
  document.getElementById('edit_stock').value = p.in_stock;
  document.getElementById('editModal').classList.add('open');
}
function closeEdit() {
  document.getElementById('editModal').classList.remove('open');
}
document.getElementById('editModal').addEventListener('click', function(e) {
  if (e.target === this) closeEdit();
});
function confirmDeleteUser(uid, name, email) {
  document.getElementById('deleteUserUid').value   = uid;
  document.getElementById('deleteUserName').textContent  = name;
  document.getElementById('deleteUserEmail').textContent = email;
  document.getElementById('deleteUserModal').classList.add('open');
}
function closeDeleteUser() {
  document.getElementById('deleteUserModal').classList.remove('open');
}
document.getElementById('deleteUserModal').addEventListener('click', function(e) {
  if (e.target === this) closeDeleteUser();
});
</script>
</body>
</html>

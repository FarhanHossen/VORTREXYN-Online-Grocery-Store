<%- include('partials/header') %>

<%
const imgMap = {
  1000:'fish-fingers.png', 1001:'fish-fingers.png',
  1002:'hamburger-patties.png', 1003:'shelled-prawns.png',
  1004:'ice-cream.png', 1005:'ice-cream.png',
  2000:'panadol.png', 2001:'panadol.png',
  2002:'bath-soap.png', 2003:'garbage-bags.png',
  2004:'garbage-bags.png', 2005:'washing-powder.png',
  2006:'laundry-bleach.png', 3000:'cheddar-cheese.png',
  3001:'cheddar-cheese.png', 3002:'tbone-steak.png',
  3003:'navel-oranges.png', 3004:'bananas.png',
  3005:'peaches.png', 3006:'grapes.png', 3007:'apples.png',
  4000:'earl-grey-tea.png', 4001:'earl-grey-tea.png',
  4002:'earl-grey-tea.png', 4003:'instant-coffee.png',
  4004:'instant-coffee.png', 4005:'chocolate-bar.png',
  5000:'dry-dog-food.png', 5001:'dry-dog-food.png',
  5002:'bird-food.png', 5003:'cat-food.png', 5004:'fish-food.png'
};
%>

<div class="page-hero">
  <div class="breadcrumb">
    <a href="/"><i class="fas fa-home"></i> Home</a>
    <i class="fas fa-chevron-right"></i>
    <a href="/products">Shop</a>
    <i class="fas fa-chevron-right"></i>
    <span><%= title %></span>
  </div>
  <h1><%= title %></h1>
  <p><%= products.length %> product<%= products.length !== 1 ? 's' : '' %> found</p>
</div>

<div class="shop-layout">
  <aside class="sidebar">
    <h3><i class="fas fa-th-large"></i> Categories</h3>
    <ul class="sidebar-cats">
      <li><a href="/products"><i class="fas fa-border-all"></i> All Products</a></li>
      <li><a href="/products/category/Beverages"><i class="fas fa-coffee"></i> Beverages</a></li>
      <li><a href="/products/category/Dairy"><i class="fas fa-cheese"></i> Dairy &amp; Eggs</a></li>
      <li><a href="/products/category/Fruits"><i class="fas fa-apple-alt"></i> Fresh Produce</a></li>
      <li><a href="/products/category/Frozen"><i class="fas fa-snowflake"></i> Frozen Foods</a></li>
      <li><a href="/products/category/Health"><i class="fas fa-heartbeat"></i> Health &amp; Care</a></li>
      <li><a href="/products/category/Home"><i class="fas fa-home"></i> Home &amp; Household</a></li>
      <li><a href="/products/category/Meat"><i class="fas fa-drumstick-bite"></i> Meat &amp; Seafood</a></li>
      <li><a href="/products/category/Pet-food"><i class="fas fa-paw"></i> Pet Supplies</a></li>
      <li><a href="/products/category/Snacks"><i class="fas fa-cookie-bite"></i> Snacks</a></li>
    </ul>
  </aside>

  <div class="products-area">
    <% if (products.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-search"></i>
        <h3>No products found</h3>
        <p>Try a different category or search term.</p>
        <a href="/products" class="btn btn-primary">Browse All Products</a>
      </div>
    <% } else { %>
      <div class="product-grid">
        <% products.forEach(product => { %>
          <div class="product-card">
            <div class="product-img">
              <img src="/images/<%= imgMap[product.product_id] || 'product-placeholder.png' %>" alt="<%= product.product_name %>">
              <% if (parseInt(product.in_stock) <= 0) { %>
                <span class="badge badge-out">Out of Stock</span>
              <% } else if (parseInt(product.in_stock) < 50) { %>
                <span class="badge badge-low">Low Stock</span>
              <% } %>
            </div>
            <div class="product-info">
              <h3><%= product.product_name %></h3>
              <p class="product-unit"><i class="fas fa-weight-hanging"></i> <%= product.unit_quantity %></p>
              <div class="product-footer">
                <span class="product-price">$<%= parseFloat(product.unit_price).toFixed(2) %></span>
                <% if (parseInt(product.in_stock) > 0) { %>
                  <form action="/cart/add" method="POST" class="add-form">
                    <input type="hidden" name="productId" value="<%= product.product_id %>">
                    <div class="qty-add-group">
                      <div class="qty-stepper">
                        <button type="button" class="qty-btn minus" onclick="stepQty(this,-1)">−</button>
                        <input type="number" name="qty" value="1" min="1" max="<%= product.in_stock %>" class="qty-field" readonly>
                        <button type="button" class="qty-btn plus" onclick="stepQty(this,1)">+</button>
                      </div>
                      <button type="submit" class="btn-add-cart">
                        <i class="fas fa-cart-plus"></i> Add
                      </button>
                    </div>
                  </form>
                <% } else { %>
                  <button class="btn-add-cart disabled" disabled>Sold Out</button>
                <% } %>
              </div>
              <% if (parseInt(product.in_stock) > 0) { %>
                <p class="stock-info"><i class="fas fa-check-circle"></i> <%= product.in_stock %> in stock</p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
function stepQty(btn, delta) {
  const group = btn.closest('.qty-stepper');
  const input = group.querySelector('.qty-field');
  const min = parseInt(input.min) || 1;
  const max = parseInt(input.max) || 9999;
  input.value = Math.min(max, Math.max(min, parseInt(input.value) + delta));
}
</script>
<%- include('partials/footer') %>

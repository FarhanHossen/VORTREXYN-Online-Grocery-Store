<%- include('partials/header') %>

<%
  const baseTotal       = total + shipping;
  const userPoints      = (user && user.rewardPoints) ? Math.floor(user.rewardPoints) : 0;
  const rate            = typeof discountRate !== 'undefined' ? discountRate : 0.50;
  const tierNum         = typeof tier !== 'undefined' ? tier : 1;
  const autoDiscPct     = typeof autoDiscountPct !== 'undefined' ? autoDiscountPct : 0;
  const autoDiscAmt     = parseFloat((baseTotal * autoDiscPct / 100).toFixed(2));
  const afterAutoTotal  = parseFloat((baseTotal - autoDiscAmt).toFixed(2));
  const maxRedeemable   = Math.min(userPoints, Math.floor(afterAutoTotal / rate) * 10);
  const hasPoints       = userPoints >= 10;
%>

<div class="page-hero">
  <div class="breadcrumb">
    <a href="/"><i class="fas fa-home"></i> Home</a>
    <i class="fas fa-chevron-right"></i>
    <a href="/cart">Cart</a>
    <i class="fas fa-chevron-right"></i>
    <a href="/cart/checkout">Delivery</a>
    <i class="fas fa-chevron-right"></i>
    <span>Payment</span>
  </div>
  <h1><i class="fas fa-credit-card"></i> Payment Details</h1>
</div>

<div class="checkout-layout">
  <div class="checkout-form-wrap">
    <div class="checkout-steps">
      <div class="step done"><i class="fas fa-shopping-cart"></i><span>Cart</span></div>
      <div class="step-line done"></div>
      <div class="step done"><i class="fas fa-map-marker-alt"></i><span>Delivery</span></div>
      <div class="step-line done"></div>
      <div class="step active"><i class="fas fa-credit-card"></i><span>Payment</span></div>
    </div>

    <form action="/cart/payment" method="POST" class="checkout-form" id="paymentForm">
      <input type="hidden" name="pointsToUse" id="pointsToUseInput" value="0">

      <!-- ── Reward Points Redemption (logged-in users only) ── -->
      <% if (autoDiscPct > 0) { %>
      <div class="tier4-autodiscount-banner">
        <% for(let s=0;s<tierNum;s++){%><i class="fas fa-star"></i><%}%>
        <span><strong>Tier 4 — 10% Auto-Discount Applied!</strong> −$<%= autoDiscAmt.toFixed(2) %> off your order total</span>
        <span class="t4-new-total">New total before points: <strong>$<%= afterAutoTotal.toFixed(2) %></strong></span>
      </div>
      <% } %>

      <% if (user && hasPoints) { %>
      <div class="form-section points-redeem-section">
        <h3>
          <% for(let s=0;s<tierNum;s++) { %><i class="fas fa-star" style="color:#f59e0b;font-size:.95rem"></i><% } %>
          Redeem Reward Points
          <span class="tier-badge tier-<%= tierNum %>"><% for(let s=0;s<tierNum;s++){%>★<%}%> Tier <%= tierNum %></span>
        </h3>
        <div class="points-redeem-body">
          <div class="points-available-row">
            <span>Remaining: <strong><%= userPoints %> pts</strong></span>
            <span class="pts-worth-tag">worth up to <strong>$<%= (maxRedeemable / 10 * rate).toFixed(2) %></strong> off</span>
          </div>
          <div class="redeem-rule"><i class="fas fa-info-circle"></i> 10 pts = $<%= rate.toFixed(2) %> (Tier <%= tierNum %>) &nbsp;|&nbsp; Multiples of 10</div>

          <div class="points-slider-wrap">
            <div class="slider-labels">
              <span>0 pts</span>
              <span id="sliderVal">0 pts selected → <strong>$0.00 off</strong></span>
              <span><%= maxRedeemable %> pts</span>
            </div>
            <input type="range" id="pointsSlider" min="0" max="<%= maxRedeemable %>"
              step="10" value="0" class="points-slider" oninput="updatePoints(this.value)">
          </div>

          <div class="discount-preview" id="discountPreview" style="display:none">
            <i class="fas fa-tag"></i>
            Using <strong id="ptsUsedLabel">0</strong> points —
            <strong id="discountLabel">$0.00</strong> discount applied
          </div>
        </div>
      </div>
      <% } else if (user && !hasPoints) { %>
      <div class="form-section">
        <div class="no-points-note">
          <i class="fas fa-star" style="color:#f59e0b"></i>
          You need at least <strong>10 points</strong> to redeem. Keep shopping to earn more!
        </div>
      </div>
      <% } %>

      <!-- ── Card Info ── -->
      <div class="form-section">
        <h3><i class="fas fa-credit-card"></i> Card Information</h3>
        <div class="card-preview" id="cardPreview">
          <div class="card-chip"><i class="fas fa-microchip"></i></div>
          <div class="card-number-display" id="cardNumDisplay">•••• •••• •••• ••••</div>
          <div class="card-bottom">
            <div><span class="card-label">Card Holder</span><span id="cardNameDisplay">YOUR NAME</span></div>
            <div><span class="card-label">Expires</span><span id="cardExpDisplay">MM/YY</span></div>
          </div>
          <div class="card-brand-icon"><i class="fas fa-credit-card"></i></div>
        </div>

        <div class="form-group">
          <label>Name on Card</label>
          <div class="input-wrap"><i class="fas fa-user"></i>
            <input type="text" name="cardName" id="cardName" placeholder="John Smith" required autocomplete="cc-name"
              oninput="document.getElementById('cardNameDisplay').textContent=this.value.toUpperCase()||'YOUR NAME'">
          </div>
        </div>
        <div class="form-group">
          <label>Card Number</label>
          <div class="input-wrap card-num-wrap"><i class="fas fa-credit-card"></i>
            <input type="text" name="cardNumber" id="cardNumber" placeholder="1234 5678 9012 3456"
              maxlength="19" required autocomplete="cc-number" oninput="formatCard(this)">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Expiry Date</label>
            <div class="input-wrap"><i class="fas fa-calendar"></i>
              <input type="text" name="cardExpiry" id="cardExpiry" placeholder="MM/YY" maxlength="5"
                required autocomplete="cc-exp" oninput="formatExpiry(this)">
            </div>
          </div>
          <div class="form-group">
            <label>CVV <i class="fas fa-question-circle cvv-tip" title="3-digit code on the back"></i></label>
            <div class="input-wrap"><i class="fas fa-lock"></i>
              <input type="password" name="cardCvv" placeholder="•••" maxlength="4" required autocomplete="cc-csc">
            </div>
          </div>
        </div>
      </div>

      <!-- ── Billing Summary ── -->
      <div class="form-section">
        <h3><i class="fas fa-receipt"></i> Billing Summary</h3>
        <div class="billing-summary">
          <div class="summary-row"><span>Subtotal</span><span>$<%= total.toFixed(2) %></span></div>
          <div class="summary-row"><span>Shipping</span><span class="<%= shipping === 0 ? 'free-tag' : '' %>"><%= shipping === 0 ? 'FREE' : '$' + shipping.toFixed(2) %></span></div>
          <div class="summary-row discount-row" id="discountRow" style="display:none">
            <span><i class="fas fa-tag" style="color:#16a34a"></i> Points Discount</span>
            <span class="discount-amt" id="discountAmt">-$0.00</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-row total-row">
            <span>Total Charged</span>
            <span id="totalDisplay">$<%= baseTotal.toFixed(2) %></span>
          </div>
        </div>
      </div>

      <div class="secure-badge">
        <i class="fas fa-lock"></i> Payments are encrypted and secure. We never store your card details.
      </div>

      <button type="submit" class="btn btn-primary full-btn submit-order" id="payBtn">
        <i class="fas fa-lock"></i> Pay $<%= baseTotal.toFixed(2) %>
      </button>
      <a href="/cart/checkout" class="btn btn-ghost full-btn" style="margin-top:10px;justify-content:center">
        <i class="fas fa-arrow-left"></i> Back to Delivery
      </a>
    </form>
  </div>

  <div class="checkout-info">
    <div class="info-card">
      <h4><i class="fas fa-map-marker-alt"></i> Delivering to</h4>
      <p><strong><%= delivery.name %></strong><br>
        <%= delivery.street %>, <%= delivery.city %>, <%= delivery.state %><br>
        <i class="fas fa-phone" style="font-size:.75rem"></i> <%= delivery.mobile %>
      </p>
    </div>
    <div class="info-card">
      <h4><i class="fas fa-shield-alt"></i> Safe & Secure</h4>
      <p>256-bit SSL encryption. Your payment info is never stored on our servers.</p>
    </div>
    <div class="info-card accepted-cards">
      <h4><i class="fas fa-credit-card"></i> Accepted Cards</h4>
      <div class="card-logos">
        <span class="card-logo visa">VISA</span>
        <span class="card-logo mc">MC</span>
        <span class="card-logo amex">AMEX</span>
      </div>
    </div>
  </div>
</div>

<script>
const BASE_TOTAL    = <%= baseTotal.toFixed(2) %>;
const DISCOUNT_RATE = <%= rate %>; // dollars per 10 pts (tier-based)

function updatePoints(val) {
  val = Math.floor(val / 10) * 10;
  const discount = (val / 10) * DISCOUNT_RATE;
  const newTotal = Math.max(0, BASE_TOTAL - discount);

  document.getElementById('pointsToUseInput').value = val;
  document.getElementById('sliderVal').innerHTML =
    val + ' pts selected → <strong>$' + discount.toFixed(2) + ' off</strong>';

  const preview = document.getElementById('discountPreview');
  const row     = document.getElementById('discountRow');
  if (val > 0) {
    preview.style.display = '';
    row.style.display     = '';
    document.getElementById('ptsUsedLabel').textContent  = val;
    document.getElementById('discountLabel').textContent = '$' + discount.toFixed(2);
    document.getElementById('discountAmt').textContent   = '-$' + discount.toFixed(2);
  } else {
    preview.style.display = 'none';
    row.style.display     = 'none';
  }
  document.getElementById('totalDisplay').textContent = '$' + newTotal.toFixed(2);
  document.getElementById('payBtn').innerHTML =
    '<i class="fas fa-lock"></i> Pay $' + newTotal.toFixed(2);
}

function formatCard(input) {
  let v = input.value.replace(/\D/g,'').substring(0,16);
  input.value = v.replace(/(.{4})/g,'$1 ').trim();
  const display = v.padEnd(16,'•').replace(/(.{4})/g,'$1 ').trim();
  document.getElementById('cardNumDisplay').textContent = display;
}
function formatExpiry(input) {
  let v = input.value.replace(/\D/g,'').substring(0,4);
  if (v.length >= 3) v = v.substring(0,2) + '/' + v.substring(2);
  input.value = v;
  document.getElementById('cardExpDisplay').textContent = v || 'MM/YY';
}
</script>
<%- include('partials/footer') %>

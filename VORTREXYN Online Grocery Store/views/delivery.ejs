<%- include('partials/header') %>

<% const s = (user && user.savedAddress) ? user.savedAddress : {}; %>

<div class="page-hero">
  <div class="breadcrumb">
    <a href="/"><i class="fas fa-home"></i> Home</a>
    <i class="fas fa-chevron-right"></i>
    <a href="/cart">Cart</a>
    <i class="fas fa-chevron-right"></i>
    <span>Checkout</span>
  </div>
  <h1><i class="fas fa-map-marker-alt"></i> Delivery Details</h1>
</div>

<div class="checkout-layout">
  <div class="checkout-form-wrap">
    <div class="checkout-steps">
      <div class="step done"><i class="fas fa-shopping-cart"></i><span>Cart</span></div>
      <div class="step-line done"></div>
      <div class="step active"><i class="fas fa-map-marker-alt"></i><span>Delivery</span></div>
      <div class="step-line"></div>
      <div class="step"><i class="fas fa-credit-card"></i><span>Payment</span></div>
    </div>

    <% if (user && user.savedAddress) { %>
    <div class="saved-address-banner">
      <div class="saved-address-inner">
        <i class="fas fa-map-marker-alt"></i>
        <div>
          <strong>Using your saved address</strong>
          <span><%= user.savedAddress.street %>, <%= user.savedAddress.city %>, <%= user.savedAddress.state %></span>
        </div>
        <a href="/account" class="btn-edit-addr"><i class="fas fa-edit"></i> Change</a>
      </div>
    </div>
    <% } %>

    <form action="/cart/checkout" method="POST" class="checkout-form">
      <div class="form-section">
        <h3><i class="fas fa-user"></i> Personal Information</h3>
        <div class="form-row">
          <div class="form-group">
            <label>Full Name</label>
            <div class="input-wrap"><i class="fas fa-user"></i>
              <input type="text" name="name" placeholder="John Smith"
                value="<%= s.name || (user && user.displayName) || '' %>" required>
            </div>
          </div>
          <div class="form-group">
            <label>Email Address</label>
            <div class="input-wrap"><i class="fas fa-envelope"></i>
              <input type="email" name="email" placeholder="john@example.com"
                value="<%= user ? user.email : '' %>" required>
            </div>
          </div>
        </div>
        <div class="form-group">
          <label>Mobile Number</label>
          <div class="input-wrap"><i class="fas fa-phone"></i>
            <input type="tel" name="mobile" pattern="[0-9 ]{8,12}" placeholder="0400 000 000"
              value="<%= s.mobile || '' %>" required>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h3><i class="fas fa-map-marker-alt"></i> Delivery Address</h3>
        <div class="form-group">
          <label>Street Address</label>
          <div class="input-wrap"><i class="fas fa-road"></i>
            <input type="text" name="street" placeholder="123 Main Street"
              value="<%= s.street || '' %>" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>City / Suburb</label>
            <div class="input-wrap"><i class="fas fa-city"></i>
              <input type="text" name="city" placeholder="Sydney"
                value="<%= s.city || '' %>" required>
            </div>
          </div>
          <div class="form-group">
            <label>State</label>
            <div class="input-wrap select-wrap"><i class="fas fa-map"></i>
              <select name="state" required>
                <option value="">Select State</option>
                <% ['NSW','VIC','QLD','WA','SA','TAS','ACT','NT','Other'].forEach(st => { %>
                  <option value="<%= st %>" <%= s.state === st ? 'selected' : '' %>><%= st %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>
      </div>

      <% if (user) { %>
      <div class="save-address-opt">
        <label class="remember-me">
          <input type="checkbox" name="saveAddress" value="1" <%= user.savedAddress ? '' : 'checked' %>>
          Save this address to my account for next time
        </label>
      </div>
      <% } %>

      <button type="submit" class="btn btn-primary full-btn submit-order">
        <i class="fas fa-arrow-right"></i> Continue to Payment
      </button>
    </form>
  </div>

  <div class="checkout-info">
    <div class="info-card">
      <h4><i class="fas fa-shield-alt"></i> Secure Checkout</h4>
      <p>Your personal details are protected and never shared with third parties.</p>
    </div>
    <div class="info-card">
      <h4><i class="fas fa-truck"></i> Fast Delivery</h4>
      <p>Orders placed before 2pm are delivered the same day.</p>
    </div>
    <div class="info-card">
      <h4><i class="fas fa-envelope"></i> Confirmation Email</h4>
      <p>You'll receive an order confirmation email once your order is placed.</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

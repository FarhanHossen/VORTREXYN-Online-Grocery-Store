<%- include('partials/header') %>

<div class="page-hero">
  <div class="breadcrumb">
    <a href="/"><i class="fas fa-home"></i> Home</a>
    <i class="fas fa-chevron-right"></i>
    <span>Shopping Cart</span>
  </div>
  <h1><i class="fas fa-shopping-cart"></i> Your Cart</h1>
</div>

<div class="cart-layout">
  <% if (!cart || Object.keys(cart).length === 0) { %>
    <div class="empty-state full-width">
      <i class="fas fa-shopping-cart"></i>
      <h3>Your cart is empty</h3>
      <p>Looks like you haven't added anything yet.</p>
      <a href="/products" class="btn btn-primary">Start Shopping</a>
    </div>
  <% } else { %>
    <div class="cart-items">
      <div class="cart-header-row">
        <span>Product</span>
        <span>Unit</span>
        <span>Price</span>
        <span>Qty</span>
        <span>Subtotal</span>
        <span></span>
      </div>
      <form action="/cart/update" method="POST" id="cart-form">
        <% let total = 0; %>
        <% for (let id in cart) {
             let item = cart[id];
             let itemTotal = item.price * item.quantity;
             total += itemTotal;
        %>
          <div class="cart-row">
            <div class="cart-item-name">
              <div class="cart-item-icon"><i class="fas fa-box-open"></i></div>
              <div>
                <strong><%= item.name %></strong>
              </div>
            </div>
            <span class="cart-cell"><%= item.unit %></span>
            <span class="cart-cell price">$<%= item.price.toFixed(2) %></span>
            <span class="cart-cell">
              <input type="number" name="quantities[<%= id %>]" value="<%= item.quantity %>" min="1" class="qty-input">
            </span>
            <span class="cart-cell price">$<%= itemTotal.toFixed(2) %></span>
            <span class="cart-cell">
              <button type="submit" name="remove" value="<%= id %>" class="btn-remove">
                <i class="fas fa-trash-alt"></i>
              </button>
            </span>
          </div>
        <% } %>
        <div class="cart-actions-row">
          <button type="submit" name="action" value="update" class="btn btn-outline">
            <i class="fas fa-sync-alt"></i> Update Cart
          </button>
        </div>
      </form>
    </div>

    <div class="cart-summary">
      <h3>Order Summary</h3>
      <% let summaryTotal = 0; for (let id in cart) { summaryTotal += cart[id].price * cart[id].quantity; } %>
      <div class="summary-row">
        <span>Subtotal</span>
        <span>$<%= summaryTotal.toFixed(2) %></span>
      </div>
      <div class="summary-row">
        <span>Delivery</span>
        <span class="free-tag"><%= summaryTotal >= 50 ? 'FREE' : '$5.99' %></span>
      </div>
      <div class="summary-divider"></div>
      <div class="summary-row total-row">
        <span>Total</span>
        <span>$<%= (summaryTotal + (summaryTotal >= 50 ? 0 : 5.99)).toFixed(2) %></span>
      </div>
      <% if (summaryTotal < 50) { %>
        <p class="delivery-note"><i class="fas fa-info-circle"></i> Add $<%= (50 - summaryTotal).toFixed(2) %> more for free delivery!</p>
      <% } %>
      <a href="/cart/checkout" class="btn btn-primary full-btn">
        <i class="fas fa-lock"></i> Proceed to Checkout
      </a>
      <form action="/cart/clear" method="POST">
        <button type="submit" class="btn btn-ghost full-btn">
          <i class="fas fa-times"></i> Clear Cart
        </button>
      </form>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>

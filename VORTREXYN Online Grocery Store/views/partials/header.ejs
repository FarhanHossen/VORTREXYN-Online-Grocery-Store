<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VORTREXYN Grocery Store</title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script>window.__firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;</script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <div class="logo">
        <a href="/" class="logo-link">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 270 52" class="logo-svg" aria-label="VORTREXYN Online Grocery Store">
            <defs>
              <linearGradient id="hbg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#1a1008"/>
                <stop offset="100%" stop-color="#080503"/>
              </linearGradient>
              <radialGradient id="hglow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity=".2"/>
                <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
              </radialGradient>
              <radialGradient id="hvglow" cx="50%" cy="72%" r="55%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity=".3"/>
                <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
              </radialGradient>
              <filter id="hvf" x="-80%" y="-80%" width="260%" height="260%">
                <feGaussianBlur stdDeviation="1.6" result="b"/>
                <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <style>
                .hbadge{animation:hPop .45s cubic-bezier(.34,1.56,.64,1) both}
                .hring{stroke-dasharray:138;stroke-dashoffset:138;animation:hDraw .65s ease-out .12s both}
                .hinner{stroke-dasharray:115;stroke-dashoffset:115;animation:hDraw .5s ease-out .38s both}
                .hs1{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .5s both}
                .hs2{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .59s both}
                .hs3{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .68s both}
                .hs4{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .77s both}
                .hs5{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .86s both}
                .hs6{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .95s both}
                .hvl{stroke-dasharray:24;stroke-dashoffset:24;animation:hVdraw .44s ease 1.12s both}
                .hvr{stroke-dasharray:24;stroke-dashoffset:24;animation:hVdraw .44s ease 1.28s both}
                .hvcl{transform-box:fill-box;transform-origin:center;animation:hPop .2s cubic-bezier(.34,1.56,.64,1) 1.44s both}
                .hvcr{transform-box:fill-box;transform-origin:center;animation:hPop .2s cubic-bezier(.34,1.56,.64,1) 1.52s both}
                .hva{transform-box:fill-box;transform-origin:center;animation:hPop .24s cubic-bezier(.34,1.56,.64,1) 1.6s both,hPulse 2.2s ease-in-out 2.1s infinite}
                .ht1{opacity:0;animation:hSlide .4s ease .3s forwards}
                .ht2{opacity:0;animation:hSlide .4s ease .5s forwards}
                @keyframes hPop{0%{opacity:0;transform:scale(0)}100%{opacity:1;transform:scale(1)}}
                @keyframes hDraw{to{stroke-dashoffset:0}}
                @keyframes hSpoke{0%{stroke-dashoffset:20;opacity:0}100%{stroke-dashoffset:0;opacity:1}}
                @keyframes hVdraw{0%{stroke-dashoffset:24;opacity:0}100%{stroke-dashoffset:0;opacity:1}}
                @keyframes hPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(1.7)}}
                @keyframes hSlide{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
              </style>
            </defs>
            <!-- Hex badge: center (26,26), radius 23, pointy-top -->
            <polygon class="hbadge" points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="url(#hbg)"/>
            <polygon points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="url(#hglow)"/>
            <!-- Outer ring -->
            <polygon class="hring" points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="none" stroke="#f59e0b" stroke-width="1" stroke-opacity=".45" stroke-linejoin="round"/>
            <!-- Inner ring -->
            <polygon class="hinner" points="26,12 38.1,19 38.1,33 26,40 13.9,33 13.9,19" fill="none" stroke="#f59e0b" stroke-width=".65" stroke-opacity=".2" stroke-linejoin="round"/>
            <!-- Six spokes (subdued) -->
            <line class="hs1" x1="26" y1="26" x2="36" y2="8.75"  stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
            <line class="hs2" x1="26" y1="26" x2="45.9" y2="26"  stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
            <line class="hs3" x1="26" y1="26" x2="36" y2="43.25" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" opacity=".55"/>
            <line class="hs4" x1="26" y1="26" x2="16" y2="43.25" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" opacity=".55"/>
            <line class="hs5" x1="26" y1="26" x2="6.1" y2="26"   stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
            <line class="hs6" x1="26" y1="26" x2="16" y2="8.75"  stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
            <!-- V glow bloom -->
            <polygon points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="url(#hvglow)" class="hvl" style="animation:hVdraw .44s ease 1.12s both;stroke:none"/>
            <g filter="url(#hvf)" opacity=".5" class="hvl">
              <line x1="17" y1="14" x2="26" y2="36" stroke="#f59e0b" stroke-width="4" stroke-linecap="round"/>
              <line x1="35" y1="14" x2="26" y2="36" stroke="#f59e0b" stroke-width="4" stroke-linecap="round"/>
            </g>
            <!-- V arms -->
            <line class="hvl" x1="17" y1="14" x2="26" y2="36" stroke="#fcd34d" stroke-width="2.6" stroke-linecap="round"/>
            <line class="hvr" x1="35" y1="14" x2="26" y2="36" stroke="#fcd34d" stroke-width="2.6" stroke-linecap="round"/>
            <!-- V end caps -->
            <circle class="hvcl" cx="17" cy="14" r="1.6" fill="#d97706"/>
            <circle class="hvcr" cx="35" cy="14" r="1.6" fill="#d97706"/>
            <!-- V apex dot (pulses) -->
            <circle class="hva" cx="26" cy="36" r="2.2" fill="#fef3c7"/>
            <!-- Brand text -->
            <text class="ht1" x="60" y="23" font-family="Inter,sans-serif" font-size="17" font-weight="800" fill="white" letter-spacing="2">VORTREXYN</text>
            <text class="ht2" x="61" y="39" font-family="Inter,sans-serif" font-size="9.5" font-weight="500" fill="rgba(255,255,255,0.55)" letter-spacing="1">Online Grocery Store</text>
          </svg>
        </a>
      </div>
      <form action="/products/search" method="GET" class="header-search">
        <i class="fas fa-search search-icon"></i>
        <input type="text" name="q" placeholder="Search for products...">
        <button type="submit">Search</button>
      </form>
      <nav class="main-nav">
        <a href="/" class="nav-link"><i class="fas fa-home"></i> Home</a>
        <a href="/products" class="nav-link"><i class="fas fa-store"></i> Shop</a>
        <a href="/cart" class="nav-link cart-link"><i class="fas fa-shopping-cart"></i> Cart</a>
        <% if (user) { %>
          <div class="nav-user-inline">
            <a href="/account" class="nav-user-identity">
              <% if (user.photoURL) { %>
                <img src="<%= user.photoURL %>" class="nav-avatar-img" alt="">
              <% } else { %>
                <span class="nav-avatar-initial"><%= (user.displayName || 'U')[0].toUpperCase() %></span>
              <% } %>
              <span class="nav-user-name"><%= user.displayName %></span>
            </a>
            <form action="/auth/logout" method="POST" style="margin:0">
              <button type="submit" class="nav-logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</button>
            </form>
          </div>
        <% } else { %>
          <a href="/auth/login" class="nav-link login-btn"><i class="fas fa-sign-in-alt"></i> Login</a>
          <a href="/auth/signup" class="btn btn-primary nav-signup"><i class="fas fa-user-plus"></i> Sign Up</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="main-content">

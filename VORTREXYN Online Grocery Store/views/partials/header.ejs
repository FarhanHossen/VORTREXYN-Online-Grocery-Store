<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VORTREXYN Grocery Store</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script>window.__firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;</script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <div class="logo">
        <a href="/"><img src="/images/logo.png" alt="VORTREXYN Logo"></a>
      </div>
      <form action="/products/search" method="GET" class="header-search">
        <i class="fas fa-search search-icon"></i>
        <input type="text" name="q" placeholder="Search for products...">
        <button type="submit">Search</button>
      </form>
      <nav class="main-nav">
        <a href="/" class="nav-link"><i class="fas fa-home"></i> Home</a>
        <a href="/products" class="nav-link"><i class="fas fa-store"></i> Shop</a>
        <% if (user) { %>
          <a href="/account" class="nav-link"><i class="fas fa-user-circle"></i> Account</a>
        <% } %>
        <a href="/cart" class="nav-link cart-link"><i class="fas fa-shopping-cart"></i> Cart</a>
        <% if (user) { %>
          <div class="nav-user-menu">
            <button class="nav-user-btn">
              <% if (user.photoURL) { %>
                <img src="<%= user.photoURL %>" class="nav-avatar-img" alt="">
              <% } else { %>
                <span class="nav-avatar-initial"><%= (user.displayName || 'U')[0].toUpperCase() %></span>
              <% } %>
              <span class="nav-user-name"><%= user.displayName %></span>
              <i class="fas fa-chevron-down" style="font-size:.6rem;opacity:.6"></i>
            </button>
            <div class="user-dropdown">
              <div class="dropdown-header">
                <i class="fas fa-star" style="color:#f59e0b"></i>
                <span>Reward Points: <strong><%= user.rewardPoints || 0 %></strong></span>
              </div>
              <form action="/auth/logout" method="POST" style="margin:0">
                <button type="submit" class="dropdown-logout"><i class="fas fa-sign-out-alt"></i> Logout</button>
              </form>
            </div>
          </div>
        <% } else { %>
          <a href="/auth/login" class="nav-link login-btn"><i class="fas fa-sign-in-alt"></i> Login</a>
          <a href="/auth/signup" class="btn btn-primary nav-signup"><i class="fas fa-user-plus"></i> Sign Up</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="main-content">

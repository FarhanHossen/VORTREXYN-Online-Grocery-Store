<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VORTREXYN Grocery Store</title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script>window.__firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;</script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <div class="logo">
        <a href="/" class="logo-link">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 270 52" class="logo-svg" aria-label="VORTREXYN Online Grocery Store">
            <defs>
              <radialGradient id="hbg" cx="38%" cy="28%" r="72%">
                <stop offset="0%" stop-color="#4a2800"/>
                <stop offset="100%" stop-color="#1c0f00"/>
              </radialGradient>
              <radialGradient id="hglow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity=".22"/>
                <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
              </radialGradient>
              <style>
                .hbg{transform-box:fill-box;transform-origin:center;animation:hPop .48s cubic-bezier(.34,1.56,.64,1) both}
                .hbody{animation:hRise .4s ease-out .35s both}
                .hgrid{animation:hFade .3s ease .6s both}
                .hhl{stroke-dasharray:42;stroke-dashoffset:42;animation:hDraw .52s ease-in-out .6s both}
                .hhr{stroke-dasharray:42;stroke-dashoffset:42;animation:hDraw .52s ease-in-out .78s both}
                .hp1{transform-box:fill-box;transform-origin:center;animation:hFall .38s cubic-bezier(.34,1.56,.64,1) 1.1s both,hSway 1.8s ease-in-out 2s infinite}
                .hp2{transform-box:fill-box;transform-origin:center;animation:hFall .38s cubic-bezier(.34,1.56,.64,1) 1.28s both,hSway 1.8s ease-in-out 2.2s infinite}
                .hp3{transform-box:fill-box;transform-origin:center;animation:hFall .38s cubic-bezier(.34,1.56,.64,1) 1.46s both,hSway 1.8s ease-in-out 2.4s infinite}
                .ht1{opacity:0;animation:hSlide .45s ease .3s forwards}
                .ht2{opacity:0;animation:hSlide .45s ease .5s forwards}
                @keyframes hPop{0%{opacity:0;transform:scale(.3)}100%{opacity:1;transform:scale(1)}}
                @keyframes hRise{0%{opacity:0;transform:translateY(7px)}100%{opacity:1;transform:translateY(0)}}
                @keyframes hFade{0%{opacity:0}100%{opacity:.5}}
                @keyframes hDraw{to{stroke-dashoffset:0}}
                @keyframes hFall{0%{opacity:0;transform:translateY(-11px) scale(.6)}100%{opacity:1;transform:translateY(0) scale(1)}}
                @keyframes hSway{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-1.5px) rotate(3deg)}}
                @keyframes hSlide{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
              </style>
            </defs>
            <!-- Warm glow behind badge -->
            <circle cx="26" cy="26" r="26" fill="url(#hglow)"/>
            <!-- Badge circle -->
            <circle class="hbg" cx="26" cy="26" r="24" fill="url(#hbg)" stroke="#f59e0b" stroke-width="1.2" stroke-opacity=".45"/>
            <!-- Basket body rises up -->
            <g class="hbody">
              <rect x="18" y="29" width="16" height="10" rx="2" fill="none" stroke="#fcd34d" stroke-width="2"/>
            </g>
            <!-- Basket grid lines -->
            <g class="hgrid">
              <line x1="18" y1="33" x2="34" y2="33" stroke="#fcd34d" stroke-width=".9"/>
              <line x1="18" y1="37" x2="34" y2="37" stroke="#fcd34d" stroke-width=".9"/>
              <line x1="23" y1="29" x2="23" y2="39" stroke="#fcd34d" stroke-width=".9"/>
              <line x1="29" y1="29" x2="29" y2="39" stroke="#fcd34d" stroke-width=".9"/>
            </g>
            <!-- Left handle (amber) -->
            <path class="hhl" d="M 12,10 Q 6,22 18,30" fill="none" stroke="#f59e0b" stroke-width="3.5" stroke-linecap="round"/>
            <!-- Right handle (amber) -->
            <path class="hhr" d="M 40,10 Q 46,22 34,30" fill="none" stroke="#f59e0b" stroke-width="3.5" stroke-linecap="round"/>
            <!-- Produce: tomato, orange, herb -->
            <g class="hp1"><circle cx="21" cy="27" r="3.2" fill="#ef4444"/><line x1="21" y1="23.8" x2="22" y2="22" stroke="#22c55e" stroke-width="1.2" stroke-linecap="round"/></g>
            <g class="hp2"><circle cx="26" cy="25" r="3.2" fill="#f59e0b"/></g>
            <g class="hp3"><circle cx="31" cy="27" r="3.2" fill="#fcd34d"/></g>
            <!-- Brand text -->
            <text class="ht1" x="60" y="23" font-family="Inter,sans-serif" font-size="17" font-weight="800" fill="white" letter-spacing="2">VORTREXYN</text>
            <text class="ht2" x="61" y="39" font-family="Inter,sans-serif" font-size="9.5" font-weight="500" fill="rgba(255,255,255,0.55)" letter-spacing="1">Online Grocery Store</text>
          </svg>
        </a>
      </div>
      <form action="/products/search" method="GET" class="header-search">
        <i class="fas fa-search search-icon"></i>
        <input type="text" name="q" placeholder="Search for products...">
        <button type="submit">Search</button>
      </form>
      <nav class="main-nav">
        <a href="/" class="nav-link"><i class="fas fa-home"></i> Home</a>
        <a href="/products" class="nav-link"><i class="fas fa-store"></i> Shop</a>
        <a href="/cart" class="nav-link cart-link"><i class="fas fa-shopping-cart"></i> Cart</a>
        <% if (user) { %>
          <div class="nav-user-inline">
            <a href="/account" class="nav-user-identity">
              <% if (user.photoURL) { %>
                <img src="<%= user.photoURL %>" class="nav-avatar-img" alt="">
              <% } else { %>
                <span class="nav-avatar-initial"><%= (user.displayName || 'U')[0].toUpperCase() %></span>
              <% } %>
              <span class="nav-user-name"><%= user.displayName %></span>
            </a>
            <form action="/auth/logout" method="POST" style="margin:0">
              <button type="submit" class="nav-logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</button>
            </form>
          </div>
        <% } else { %>
          <a href="/auth/login" class="nav-link login-btn"><i class="fas fa-sign-in-alt"></i> Login</a>
          <a href="/auth/signup" class="btn btn-primary nav-signup"><i class="fas fa-user-plus"></i> Sign Up</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="main-content">

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VORTREXYN Grocery Store</title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script>window.__firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;</script>
</head>
<body>

<!-- ── Splash screen ───────────────────────────────────────────────────── -->
<div id="vx-splash">
  <style>
    #vx-splash{position:fixed;inset:0;z-index:99999;background:#070503;display:none;align-items:center;justify-content:center;flex-direction:column;gap:0}
    .sp-wrap{display:flex;flex-direction:column;align-items:center;gap:28px}
    .sp-logo{width:170px;height:170px;filter:drop-shadow(0 0 50px rgba(245,158,11,.45))}
    .sp-wordmark{font-family:'Playfair Display',serif;font-size:44px;font-weight:800;color:#f0e6d3;letter-spacing:10px;opacity:0;animation:spNameIn .65s ease 2.05s forwards}
    .sp-sub{font-family:Inter,sans-serif;font-size:11px;font-weight:600;color:#f59e0b;letter-spacing:5px;text-transform:uppercase;opacity:0;animation:spNameIn .55s ease 2.3s forwards}
    .sp-line{width:40px;height:1px;background:rgba(245,158,11,.3);opacity:0;animation:spCapIn .5s ease 2.55s forwards}
    .sp-caption{font-family:Inter,sans-serif;font-size:11px;font-weight:400;color:#7a6250;letter-spacing:4px;text-transform:uppercase;opacity:0;animation:spCapIn .65s ease 2.72s forwards}
    @keyframes spNameIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
    @keyframes spCapIn{from{opacity:0}to{opacity:1}}
    @keyframes spOut{from{opacity:1}to{opacity:0}}

    /* Splash hex-V SVG animation classes (sp- prefix, isolated from header) */
    .sp-bg{animation:spPop .45s cubic-bezier(.34,1.56,.64,1) both}
    .sp-ring{stroke-dasharray:216;stroke-dashoffset:216;animation:spDraw .68s ease-out .1s both}
    .sp-inner{stroke-dasharray:115;stroke-dashoffset:115;animation:spDraw .52s ease-out .36s both}
    .sp-s1{stroke-dasharray:31;stroke-dashoffset:31;animation:spSpoke .3s ease .48s both}
    .sp-s2{stroke-dasharray:31;stroke-dashoffset:31;animation:spSpoke .3s ease .58s both}
    .sp-s3{stroke-dasharray:31;stroke-dashoffset:31;animation:spSpoke .3s ease .68s both}
    .sp-s4{stroke-dasharray:31;stroke-dashoffset:31;animation:spSpoke .3s ease .78s both}
    .sp-s5{stroke-dasharray:31;stroke-dashoffset:31;animation:spSpoke .3s ease .88s both}
    .sp-s6{stroke-dasharray:31;stroke-dashoffset:31;animation:spSpoke .3s ease .98s both}
    .sp-vl{stroke-dasharray:33;stroke-dashoffset:33;animation:spVdraw .48s ease 1.18s both}
    .sp-vr{stroke-dasharray:33;stroke-dashoffset:33;animation:spVdraw .48s ease 1.36s both}
    .sp-vcl{transform-box:fill-box;transform-origin:center;animation:spPop .22s cubic-bezier(.34,1.56,.64,1) 1.52s both}
    .sp-vcr{transform-box:fill-box;transform-origin:center;animation:spPop .22s cubic-bezier(.34,1.56,.64,1) 1.62s both}
    .sp-va{transform-box:fill-box;transform-origin:center;animation:spPop .28s cubic-bezier(.34,1.56,.64,1) 1.72s both,spPulse 2.2s ease-in-out 2.2s infinite}
    @keyframes spPop{0%{opacity:0;transform:scale(0)}100%{opacity:1;transform:scale(1)}}
    @keyframes spDraw{to{stroke-dashoffset:0}}
    @keyframes spSpoke{0%{stroke-dashoffset:31;opacity:0}100%{stroke-dashoffset:0;opacity:1}}
    @keyframes spVdraw{0%{stroke-dashoffset:33;opacity:0}100%{stroke-dashoffset:0;opacity:1}}
    @keyframes spPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(1.7)}}
  </style>

  <div class="sp-wrap">
    <!-- Hex V logo (large) -->
    <svg class="sp-logo" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="sp-bg-g" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#1a1008"/>
          <stop offset="100%" stop-color="#080503"/>
        </linearGradient>
        <radialGradient id="sp-glow-g" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity=".22"/>
          <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="sp-vglow-g" cx="50%" cy="72%" r="52%">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity=".32"/>
          <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
        </radialGradient>
        <filter id="sp-vf" x="-70%" y="-70%" width="240%" height="240%">
          <feGaussianBlur stdDeviation="2.6" result="b"/>
          <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <polygon class="sp-bg" points="40,3 74,21.5 74,58.5 40,77 6,58.5 6,21.5" fill="url(#sp-bg-g)"/>
      <polygon points="40,3 74,21.5 74,58.5 40,77 6,58.5 6,21.5" fill="url(#sp-glow-g)"/>
      <polygon class="sp-ring" points="40,3 74,21.5 74,58.5 40,77 6,58.5 6,21.5" fill="none" stroke="#f59e0b" stroke-width="1.3" stroke-opacity=".48" stroke-linejoin="round"/>
      <polygon class="sp-inner" points="40,14 63,27 63,53 40,66 17,53 17,27" fill="none" stroke="#f59e0b" stroke-width=".85" stroke-opacity=".22" stroke-linejoin="round"/>
      <line class="sp-s1" x1="40" y1="40" x2="67" y2="24" stroke="#b45309" stroke-width="2.2" stroke-linecap="round" opacity=".7"/>
      <line class="sp-s2" x1="40" y1="40" x2="40"  y2="9"  stroke="#b45309" stroke-width="2.2" stroke-linecap="round" opacity=".7"/>
      <line class="sp-s3" x1="40" y1="40" x2="13" y2="24" stroke="#b45309" stroke-width="2.2" stroke-linecap="round" opacity=".7"/>
      <line class="sp-s4" x1="40" y1="40" x2="13" y2="56" stroke="#92400e" stroke-width="2.2" stroke-linecap="round" opacity=".55"/>
      <line class="sp-s5" x1="40" y1="40" x2="40"  y2="71" stroke="#92400e" stroke-width="2.2" stroke-linecap="round" opacity=".55"/>
      <line class="sp-s6" x1="40" y1="40" x2="67" y2="56" stroke="#92400e" stroke-width="2.2" stroke-linecap="round" opacity=".55"/>
      <polygon points="40,3 74,21.5 74,58.5 40,77 6,58.5 6,21.5" fill="url(#sp-vglow-g)" class="sp-vl" style="animation:spVdraw .48s ease 1.18s both;stroke:none"/>
      <g filter="url(#sp-vf)" opacity=".55" class="sp-vl">
        <line x1="27" y1="21" x2="40" y2="53" stroke="#f59e0b" stroke-width="6" stroke-linecap="round"/>
        <line x1="53" y1="21" x2="40" y2="53" stroke="#f59e0b" stroke-width="6" stroke-linecap="round"/>
      </g>
      <line class="sp-vl" x1="27" y1="21" x2="40" y2="53" stroke="#fcd34d" stroke-width="3.8" stroke-linecap="round"/>
      <line class="sp-vr" x1="53" y1="21" x2="40" y2="53" stroke="#fcd34d" stroke-width="3.8" stroke-linecap="round"/>
      <circle class="sp-vcl" cx="27" cy="21" r="2.2" fill="#d97706"/>
      <circle class="sp-vcr" cx="53" cy="21" r="2.2" fill="#d97706"/>
      <circle class="sp-va"  cx="40" cy="53" r="3"   fill="#fef3c7"/>
    </svg>

    <div class="sp-wordmark">VORTREXYN</div>
    <div class="sp-sub">Online Grocery Store</div>
    <div class="sp-line"></div>
    <div class="sp-caption">Your Everyday Night Market</div>
  </div>

  <script>
    (function(){
      var el = document.getElementById('vx-splash');

      // Use the Navigation API to detect HOW we arrived at this page:
      //   'reload'        → F5 / Ctrl+R refresh      → show splash
      //   'back_forward'  → browser back/forward      → skip splash
      //   'navigate'      → link / form / address bar → check referrer
      //     └─ internal referrer (same origin)        → skip splash
      //     └─ no referrer or external referrer       → show splash (first visit / external link)
      var nav = performance.getEntriesByType('navigation')[0];
      var navType = nav ? nav.type : 'navigate';

      var hasInternalRef = (function(){
        try { return document.referrer !== '' && new URL(document.referrer).origin === location.origin; }
        catch(e) { return false; }
      })();

      var skip = navType === 'back_forward' ||
                 (navType === 'navigate' && hasInternalRef);

      // Splash is hidden by default — only activate it when needed
      if (skip) return;

      el.style.display = 'flex';

      // Auto-dismiss after 3.7 s
      setTimeout(function(){
        el.style.animation = 'spOut 0.75s ease forwards';
        setTimeout(function(){ el.style.display = 'none'; }, 750);
      }, 3700);
    })();
  </script>
</div>
<!-- ── End splash ──────────────────────────────────────────────────────── -->

  <header class="site-header">
    <div class="header-inner">
      <div class="logo">
        <a href="/" class="logo-link">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 270 52" class="logo-svg" aria-label="VORTREXYN Online Grocery Store">
            <defs>
              <linearGradient id="hbg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#1a1008"/>
                <stop offset="100%" stop-color="#080503"/>
              </linearGradient>
              <radialGradient id="hglow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity=".2"/>
                <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
              </radialGradient>
              <radialGradient id="hvglow" cx="50%" cy="72%" r="55%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity=".3"/>
                <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
              </radialGradient>
              <filter id="hvf" x="-80%" y="-80%" width="260%" height="260%">
                <feGaussianBlur stdDeviation="1.6" result="b"/>
                <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <style>
                .hbadge{animation:hPop .45s cubic-bezier(.34,1.56,.64,1) both}
                .hring{stroke-dasharray:138;stroke-dashoffset:138;animation:hDraw .65s ease-out .12s both}
                .hinner{stroke-dasharray:115;stroke-dashoffset:115;animation:hDraw .5s ease-out .38s both}
                .hs1{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .5s both}
                .hs2{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .59s both}
                .hs3{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .68s both}
                .hs4{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .77s both}
                .hs5{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .86s both}
                .hs6{stroke-dasharray:20;stroke-dashoffset:20;animation:hSpoke .28s ease .95s both}
                .hvl{stroke-dasharray:24;stroke-dashoffset:24;animation:hVdraw .44s ease 1.12s both}
                .hvr{stroke-dasharray:24;stroke-dashoffset:24;animation:hVdraw .44s ease 1.28s both}
                .hvcl{transform-box:fill-box;transform-origin:center;animation:hPop .2s cubic-bezier(.34,1.56,.64,1) 1.44s both}
                .hvcr{transform-box:fill-box;transform-origin:center;animation:hPop .2s cubic-bezier(.34,1.56,.64,1) 1.52s both}
                .hva{transform-box:fill-box;transform-origin:center;animation:hPop .24s cubic-bezier(.34,1.56,.64,1) 1.6s both,hPulse 2.2s ease-in-out 2.1s infinite}
                .ht1{opacity:0;animation:hSlide .4s ease .3s forwards}
                .ht2{opacity:0;animation:hSlide .4s ease .5s forwards}
                @keyframes hPop{0%{opacity:0;transform:scale(0)}100%{opacity:1;transform:scale(1)}}
                @keyframes hDraw{to{stroke-dashoffset:0}}
                @keyframes hSpoke{0%{stroke-dashoffset:20;opacity:0}100%{stroke-dashoffset:0;opacity:1}}
                @keyframes hVdraw{0%{stroke-dashoffset:24;opacity:0}100%{stroke-dashoffset:0;opacity:1}}
                @keyframes hPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(1.7)}}
                @keyframes hSlide{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
              </style>
            </defs>
            <!-- Hex badge: center (26,26), radius 23, pointy-top -->
            <polygon class="hbadge" points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="url(#hbg)"/>
            <polygon points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="url(#hglow)"/>
            <!-- Outer ring -->
            <polygon class="hring" points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="none" stroke="#f59e0b" stroke-width="1" stroke-opacity=".45" stroke-linejoin="round"/>
            <!-- Inner ring -->
            <polygon class="hinner" points="26,12 38.1,19 38.1,33 26,40 13.9,33 13.9,19" fill="none" stroke="#f59e0b" stroke-width=".65" stroke-opacity=".2" stroke-linejoin="round"/>
            <!-- Six spokes (subdued) -->
            <line class="hs1" x1="26" y1="26" x2="36" y2="8.75"  stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
            <line class="hs2" x1="26" y1="26" x2="45.9" y2="26"  stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
            <line class="hs3" x1="26" y1="26" x2="36" y2="43.25" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" opacity=".55"/>
            <line class="hs4" x1="26" y1="26" x2="16" y2="43.25" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" opacity=".55"/>
            <line class="hs5" x1="26" y1="26" x2="6.1" y2="26"   stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
            <line class="hs6" x1="26" y1="26" x2="16" y2="8.75"  stroke="#b45309" stroke-width="1.5" stroke-linecap="round" opacity=".7"/>
            <!-- V glow bloom -->
            <polygon points="26,3 45.9,14.5 45.9,37.5 26,49 6.1,37.5 6.1,14.5" fill="url(#hvglow)" class="hvl" style="animation:hVdraw .44s ease 1.12s both;stroke:none"/>
            <g filter="url(#hvf)" opacity=".5" class="hvl">
              <line x1="17" y1="14" x2="26" y2="36" stroke="#f59e0b" stroke-width="4" stroke-linecap="round"/>
              <line x1="35" y1="14" x2="26" y2="36" stroke="#f59e0b" stroke-width="4" stroke-linecap="round"/>
            </g>
            <!-- V arms -->
            <line class="hvl" x1="17" y1="14" x2="26" y2="36" stroke="#fcd34d" stroke-width="2.6" stroke-linecap="round"/>
            <line class="hvr" x1="35" y1="14" x2="26" y2="36" stroke="#fcd34d" stroke-width="2.6" stroke-linecap="round"/>
            <!-- V end caps -->
            <circle class="hvcl" cx="17" cy="14" r="1.6" fill="#d97706"/>
            <circle class="hvcr" cx="35" cy="14" r="1.6" fill="#d97706"/>
            <!-- V apex dot (pulses) -->
            <circle class="hva" cx="26" cy="36" r="2.2" fill="#fef3c7"/>
            <!-- Brand text -->
            <text class="ht1" x="60" y="23" font-family="Inter,sans-serif" font-size="17" font-weight="800" fill="white" letter-spacing="2">VORTREXYN</text>
            <text class="ht2" x="61" y="39" font-family="Inter,sans-serif" font-size="9.5" font-weight="500" fill="rgba(255,255,255,0.55)" letter-spacing="1">Online Grocery Store</text>
          </svg>
        </a>
      </div>
      <form action="/products/search" method="GET" class="header-search">
        <i class="fas fa-search search-icon"></i>
        <input type="text" name="q" placeholder="Search for products...">
        <button type="submit">Search</button>
      </form>
      <nav class="main-nav">
        <a href="/" class="nav-link"><i class="fas fa-home"></i> Home</a>
        <a href="/products" class="nav-link"><i class="fas fa-store"></i> Shop</a>
        <a href="/cart" class="nav-link cart-link"><i class="fas fa-shopping-cart"></i> Cart</a>
        <% if (user) { %>
          <div class="nav-user-inline">
            <a href="/account" class="nav-user-identity">
              <% if (user.photoURL) { %>
                <img src="<%= user.photoURL %>" class="nav-avatar-img" alt="">
              <% } else { %>
                <span class="nav-avatar-initial"><%= (user.displayName || 'U')[0].toUpperCase() %></span>
              <% } %>
              <span class="nav-user-name"><%= user.displayName %></span>
            </a>
            <form action="/auth/logout" method="POST" style="margin:0">
              <button type="submit" class="nav-logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</button>
            </form>
          </div>
        <% } else { %>
          <a href="/auth/login" class="nav-link login-btn"><i class="fas fa-sign-in-alt"></i> Login</a>
          <a href="/auth/signup" class="btn btn-primary nav-signup"><i class="fas fa-user-plus"></i> Sign Up</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="main-content">

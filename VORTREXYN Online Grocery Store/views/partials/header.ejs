<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VORTREXYN Grocery Store</title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script>window.__firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;</script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <div class="logo">
        <a href="/" class="logo-link">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 260 52" class="logo-svg" aria-label="VORTREXYN Online Grocery Store">
            <defs>
              <linearGradient id="hbg" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#15803d"/>
                <stop offset="100%" stop-color="#4ade80"/>
              </linearGradient>
              <style>
                .hc{animation:hPop .4s cubic-bezier(.34,1.56,.64,1) forwards;opacity:0}
                .hl{stroke-dasharray:50;stroke-dashoffset:50;animation:hDraw .5s cubic-bezier(.4,0,.2,1) .3s forwards}
                .hr{stroke-dasharray:50;stroke-dashoffset:50;animation:hDraw .5s cubic-bezier(.4,0,.2,1) .45s forwards}
                .hd{opacity:0;animation:hPop .3s ease .85s forwards}
                .ht1{opacity:0;animation:hSlide .45s ease .3s forwards}
                .ht2{opacity:0;animation:hSlide .45s ease .5s forwards}
                @keyframes hDraw{to{stroke-dashoffset:0}}
                @keyframes hPop{0%{opacity:0;transform:scale(.5)}100%{opacity:1;transform:scale(1)}}
                @keyframes hSlide{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
              </style>
            </defs>
            <circle class="hc" cx="26" cy="26" r="24" fill="url(#hbg)"/>
            <line class="hl" x1="14" y1="13" x2="26" y2="36" stroke="white" stroke-width="5" stroke-linecap="round"/>
            <line class="hr" x1="26" y1="36" x2="38" y2="13" stroke="white" stroke-width="5" stroke-linecap="round"/>
            <circle class="hd" cx="26" cy="36" r="3.2" fill="white"/>
            <text class="ht1" x="60" y="23" font-family="Inter,sans-serif" font-size="17" font-weight="800" fill="white" letter-spacing="2">VORTREXYN</text>
            <text class="ht2" x="61" y="39" font-family="Inter,sans-serif" font-size="9.5" font-weight="500" fill="rgba(255,255,255,0.6)" letter-spacing="1">Online Grocery Store</text>
          </svg>
        </a>
      </div>
      <form action="/products/search" method="GET" class="header-search">
        <i class="fas fa-search search-icon"></i>
        <input type="text" name="q" placeholder="Search for products...">
        <button type="submit">Search</button>
      </form>
      <nav class="main-nav">
        <a href="/" class="nav-link"><i class="fas fa-home"></i> Home</a>
        <a href="/products" class="nav-link"><i class="fas fa-store"></i> Shop</a>
        <a href="/cart" class="nav-link cart-link"><i class="fas fa-shopping-cart"></i> Cart</a>
        <% if (user) { %>
          <div class="nav-user-inline">
            <a href="/account" class="nav-user-identity">
              <% if (user.photoURL) { %>
                <img src="<%= user.photoURL %>" class="nav-avatar-img" alt="">
              <% } else { %>
                <span class="nav-avatar-initial"><%= (user.displayName || 'U')[0].toUpperCase() %></span>
              <% } %>
              <span class="nav-user-name"><%= user.displayName %></span>
            </a>
            <form action="/auth/logout" method="POST" style="margin:0">
              <button type="submit" class="nav-logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</button>
            </form>
          </div>
        <% } else { %>
          <a href="/auth/login" class="nav-link login-btn"><i class="fas fa-sign-in-alt"></i> Login</a>
          <a href="/auth/signup" class="btn btn-primary nav-signup"><i class="fas fa-user-plus"></i> Sign Up</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="main-content">

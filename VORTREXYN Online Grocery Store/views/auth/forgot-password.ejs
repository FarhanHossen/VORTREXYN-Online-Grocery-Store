<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-brand">
      <div class="auth-icon-wrap"><i class="fas fa-key"></i></div>
      <h1>Reset password</h1>
      <p>We'll send a reset link to your email</p>
    </div>

    <% if (sent) { %>
      <div class="auth-alert success">
        <i class="fas fa-check-circle"></i> Reset email sent! Check your inbox.
      </div>
      <a href="/auth/login" class="btn btn-primary full-btn" style="margin-top:20px">
        <i class="fas fa-sign-in-alt"></i> Back to Login
      </a>
    <% } else { %>
      <form id="forgotForm" class="auth-form">
        <div class="form-group">
          <label>Email Address</label>
          <div class="input-wrap"><i class="fas fa-envelope"></i><input type="email" id="forgotEmail" placeholder="you@example.com" required></div>
        </div>
        <button type="submit" class="btn btn-primary full-btn auth-submit">
          <span class="btn-text"><i class="fas fa-paper-plane"></i> Send Reset Link</span>
          <span class="btn-loading" style="display:none"><i class="fas fa-spinner fa-spin"></i> Sending...</span>
        </button>
      </form>
    <% } %>

    <p class="auth-switch"><a href="/auth/login"><i class="fas fa-arrow-left"></i> Back to Login</a></p>
  </div>
</div>

<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
<script src="/js/firebase-init.js"></script>
<script src="/js/auth.js"></script>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-brand">
      <img src="/images/logo.svg" alt="VORTREXYN" height="70">
      <h1>Create account</h1>
      <p>Join VORTREXYN and earn reward points</p>
    </div>

    <% if (error) { %><div class="auth-alert error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

    <form id="signupForm" class="auth-form">
      <div class="form-group">
        <label>Full Name</label>
        <div class="input-wrap"><i class="fas fa-user"></i><input type="text" id="signupName" placeholder="John Smith" required></div>
      </div>
      <div class="form-group">
        <label>Email Address</label>
        <div class="input-wrap"><i class="fas fa-envelope"></i><input type="email" id="signupEmail" placeholder="you@example.com" required></div>
      </div>
      <div class="form-group">
        <label>Password</label>
        <div class="input-wrap pw-wrap">
          <i class="fas fa-lock"></i>
          <input type="password" id="signupPassword" placeholder="Min. 6 characters" required minlength="6">
          <button type="button" class="pw-toggle" onclick="togglePw('signupPassword',this)"><i class="fas fa-eye"></i></button>
        </div>
      </div>
      <div class="form-group">
        <label>Confirm Password</label>
        <div class="input-wrap pw-wrap">
          <i class="fas fa-lock"></i>
          <input type="password" id="signupConfirm" placeholder="Repeat password" required>
          <button type="button" class="pw-toggle" onclick="togglePw('signupConfirm',this)"><i class="fas fa-eye"></i></button>
        </div>
      </div>
      <button type="submit" class="btn btn-primary full-btn auth-submit">
        <span class="btn-text"><i class="fas fa-user-plus"></i> Create Account</span>
        <span class="btn-loading" style="display:none"><i class="fas fa-spinner fa-spin"></i> Creating...</span>
      </button>
    </form>

    <p class="auth-switch">Already have an account? <a href="/auth/login">Sign in</a></p>
    <p class="auth-guest"><a href="/"><i class="fas fa-arrow-left"></i> Continue as guest</a></p>
  </div>
</div>

<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
<script src="/js/firebase-init.js"></script>
<script src="/js/auth.js"></script>

<%- include('../partials/footer') %>

<%- include('partials/header') %>

<div class="page-hero">
  <div class="breadcrumb">
    <a href="/"><i class="fas fa-home"></i> Home</a>
    <i class="fas fa-chevron-right"></i>
    <span>My Account</span>
  </div>
  <h1><i class="fas fa-user-circle"></i> My Account</h1>
</div>

<div class="account-layout">

<%
  const tier           = user.tier || 1;
  const totalEarned    = user.totalPointsEarned || 0;
  const discountRate   = tier >= 6 ? 2.50 : tier === 5 ? 2.00 : tier === 4 ? 2.00 : tier === 3 ? 1.50 : tier === 2 ? 1.00 : 0.50;
  const autoDiscPct    = tier >= 6 ? 15 : tier === 5 ? 10 : 0;
  const balance        = user.rewardPoints || 0;
  const maxDiscount    = (Math.floor(balance / 10) * discountRate).toFixed(2);
  const tierNames      = { 1: 'Iron', 2: 'Bronze', 3: 'Silver', 4: 'Gold', 5: 'Diamond', 6: 'Titanium' };
  const tierRange      = tier === 1 ? 500 : tier === 2 ? 1000 : tier === 3 ? 2000 : tier === 4 ? 3000 : tier === 5 ? 5000 : 5000;
  const tierMin        = 0;
  const tierMax        = tierRange;
  const barPct         = tier === 6 ? 100 : Math.min(100, Math.round(totalEarned / tierRange * 100));
  const ptsToNext      = tier < 6 ? Math.max(0, tierRange - totalEarned) : 0;
  const discRateLabels = { 1: '$0.50', 2: '$1.00', 3: '$1.50', 4: '$2.00', 5: '$2.00', 6: '$2.50' };
%>
  <!-- Points Card -->
  <div class="account-points-banner tier-<%= tier %>-banner">
    <div class="medal-wrap medal-t<%= tier %>">
      <div class="medal-ribbon-left"></div>
      <div class="medal-ribbon-right"></div>
      <div class="medal-disc">
        <div class="medal-inner">
          <div class="medal-stars">
            <% for(let s=0;s<Math.min(tier,6);s++) { %><i class="fas fa-star"></i><% } %>
          </div>
          <span class="medal-tier-num">T<%= tier %></span>
        </div>
      </div>
      <span class="medal-label"><%= tierNames[tier] %></span>
    </div>
    <div class="points-info">
      <div class="tier-label-row">
        <span class="tier-pill tier-<%= tier %>">
          <% for(let s=0;s<Math.min(tier,6);s++) { %>★<% } %> <%= tierNames[tier] %>
        </span>
        <h2>Your Rewards</h2>
      </div>

      <div class="pts-split-row">
        <div class="pts-split-item">
          <span class="pts-split-val"><%= balance %></span>
          <span class="pts-split-key">Remaining Points</span>
          <span class="pts-split-note">Available to spend</span>
        </div>
        <div class="pts-split-divider"></div>
        <div class="pts-split-item">
          <span class="pts-split-val pts-earned-col"><%= totalEarned %></span>
          <span class="pts-split-key">Total Earned</span>
          <span class="pts-split-note">Tier progress</span>
        </div>
      </div>

      <p class="points-rule">
        <i class="fas fa-info-circle"></i>
        10 pts = <strong><%= discRateLabels[tier] %></strong> off
        <% if (autoDiscPct > 0) { %>
          &nbsp;·&nbsp; <span class="tier4-auto-badge"><i class="fas fa-bolt"></i> +<%= autoDiscPct %>% auto-discount every order</span>
        <% } else { %>
          &nbsp;·&nbsp; <span class="pts-to-next"><%= ptsToNext %> more pts earned → <%= tierNames[tier + 1] %></span>
        <% } %>
      </p>

      <!-- Tier progress bar (current tier range only) -->
      <div class="tier-progress-wrap">
        <div class="tier-bar-range-labels">
          <span><%= tierMin %> pts</span>
          <% if (tier < 6) { %>
            <span class="tier-bar-pct-label"><%= totalEarned %> / <%= tierRange %> pts</span>
          <% } %>
          <span><%= tier < 6 ? tierMax + ' pts' : 'MAX ★★★★★★' %></span>
        </div>
        <div class="milestone-bar">
          <div class="milestone-fill tier-<%= tier %>-fill" style="width:<%= barPct %>%"></div>
        </div>
        <% if (tier < 6) { %>
        <p class="tier-bar-note"><%= ptsToNext %> more pts earned to unlock <%= tierNames[tier + 1] %></p>
        <% } else { %>
        <p class="tier-bar-note" style="color:#c084fc">★★★★★★ Titanium — Maximum tier reached!</p>
        <% } %>
      </div>

      <div class="points-stats">
        <div class="stat"><span class="stat-val"><%= user.totalOrders || 0 %></span><span class="stat-key">Orders</span></div>
        <div class="stat"><span class="stat-val">$<%= maxDiscount %></span><span class="stat-key">Max Discount</span></div>
        <div class="stat"><span class="stat-val"><%= discRateLabels[tier] %></span><span class="stat-key">Per 10 Pts</span></div>
        <% if (autoDiscPct > 0) { %><div class="stat"><span class="stat-val tier4-glow"><%= autoDiscPct %>%</span><span class="stat-key">Auto Off</span></div><% } %>
      </div>
    </div>
  </div>

  <% if (typeof didReset !== 'undefined' && didReset) { %>
  <div class="reset-confirm-banner">
    <i class="fas fa-check-circle"></i> Account reset to 0 — points, earned total and orders all cleared.
  </div>
  <% } %>
  <% if (typeof didSave !== 'undefined' && didSave) { %>
  <div class="reset-confirm-banner">
    <i class="fas fa-map-marker-alt"></i> Address saved — it will be auto-filled at every future checkout.
  </div>
  <% } %>

  <div class="account-grid">

    <!-- Profile Info -->
    <div class="account-card">
      <div class="account-card-header">
        <i class="fas fa-user"></i> Profile
      </div>
      <div class="account-card-body">
        <div class="profile-avatar">
          <% if (user.photoURL) { %>
            <img src="<%= user.photoURL %>" alt="Profile" class="avatar-img">
          <% } else { %>
            <div class="avatar-initials"><%= (user.displayName || 'U')[0].toUpperCase() %></div>
          <% } %>
        </div>
        <div class="profile-details">
          <div class="detail-row"><span class="detail-key"><i class="fas fa-user"></i> Name</span><span><%= user.displayName %></span></div>
          <div class="detail-row"><span class="detail-key"><i class="fas fa-envelope"></i> Email</span><span><%= user.email %></span></div>
        </div>
      </div>
    </div>

    <!-- Saved Address -->
    <div class="account-card">
      <div class="account-card-header">
        <i class="fas fa-map-marker-alt"></i> Saved Delivery Address
        <span class="header-note">Auto-filled at checkout</span>
      </div>
      <div class="account-card-body">
        <% if (saved) { %>
          <div class="saved-address-display" id="addressDisplay">
            <p><i class="fas fa-user"></i> <strong><%= saved.name %></strong></p>
            <p><i class="fas fa-phone"></i> <%= saved.mobile %></p>
            <p><i class="fas fa-road"></i> <%= saved.street %></p>
            <p><i class="fas fa-city"></i> <%= saved.city %>, <%= saved.state %></p>
            <button onclick="showEditForm()" class="btn btn-outline" style="margin-top:12px">
              <i class="fas fa-edit"></i> Edit Address
            </button>
          </div>
        <% } %>

        <form action="/account" method="POST" class="address-form <%= saved ? 'hidden' : '' %>" id="addressForm">
          <div class="form-row">
            <div class="form-group">
              <label>Full Name</label>
              <div class="input-wrap"><i class="fas fa-user"></i>
                <input type="text" name="name" value="<%= saved ? saved.name : user.displayName %>" placeholder="John Smith" required>
              </div>
            </div>
            <div class="form-group">
              <label>Mobile Number</label>
              <div class="input-wrap"><i class="fas fa-phone"></i>
                <input type="tel" name="mobile" value="<%= saved ? saved.mobile : '' %>" placeholder="0400 000 000" required>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label>Street Address</label>
            <div class="input-wrap"><i class="fas fa-road"></i>
              <input type="text" name="street" value="<%= saved ? saved.street : '' %>" placeholder="123 Main Street" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>City / Suburb</label>
              <div class="input-wrap"><i class="fas fa-city"></i>
                <input type="text" name="city" value="<%= saved ? saved.city : '' %>" placeholder="Sydney" required>
              </div>
            </div>
            <div class="form-group">
              <label>State</label>
              <div class="input-wrap select-wrap"><i class="fas fa-map"></i>
                <select name="state" required>
                  <option value="">Select State</option>
                  <% ['NSW','VIC','QLD','WA','SA','TAS','ACT','NT','Other'].forEach(s => { %>
                    <option value="<%= s %>" <%= saved && saved.state === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </div>
            </div>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Address</button>
            <% if (saved) { %>
              <button type="button" onclick="hideEditForm()" class="btn btn-ghost">Cancel</button>
            <% } %>
          </div>
        </form>
      </div>
    </div>

  </div><!-- /.account-grid -->

  <div class="reset-section">
    <form action="/account/reset" method="POST"
      onsubmit="return confirm('This will reset your points, tier progress and order count to zero. Continue?')">
      <button type="submit" class="btn-reset">
        <i class="fas fa-undo"></i> Reset Points & Orders to Zero
      </button>
    </form>
  </div>

</div>

<% if (saved) { %>
<script>
function showEditForm() {
  document.getElementById('addressDisplay').style.display = 'none';
  document.getElementById('addressForm').classList.remove('hidden');
}
function hideEditForm() {
  document.getElementById('addressDisplay').style.display = '';
  document.getElementById('addressForm').classList.add('hidden');
}
</script>
<% } %>

<% if ((typeof firestoreUpdate !== 'undefined' && firestoreUpdate) || (typeof firestoreReset !== 'undefined' && firestoreReset)) { %>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
<script src="/js/firebase-init.js"></script>
<script>
(async () => {
  try {
    const uid     = '<%= user.uid %>';
    const payload = <% if (typeof firestoreReset !== 'undefined' && firestoreReset) { %>
      { rewardPoints: 0, totalPointsEarned: 0, totalOrders: 0 }
    <% } else { %>
      { savedAddress: <%- JSON.stringify(firestoreUpdate) %> }
    <% } %>;

    // Ensure Firebase has an auth token (same pattern as order confirmation)
    const auth = firebase.auth();
    if (!auth.currentUser) {
      await auth.signInAnonymously().catch(() => {});
    }

    await firebase.firestore()
      .collection('users').doc(uid)
      .set(payload, { merge: true });

    console.log('Firestore synced:', payload);
  } catch (e) {
    console.warn('Firestore sync error:', e.message);
  }
})();
</script>
<% } %>

<%- include('partials/footer') %>

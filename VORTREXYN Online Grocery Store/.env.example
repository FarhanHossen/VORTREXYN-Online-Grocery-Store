# Copy this file to .env and fill in your values for local development.
# In Netlify, set these as environment variables in Site configuration.
# NEVER commit .env to git — it is listed in .gitignore.

# PostgreSQL — Neon connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session encryption key — any long random string
SESSION_SECRET=replace_with_a_long_random_secret

# Firebase Admin SDK — from your service account JSON file
# In Netlify: paste the private key exactly as shown in the JSON,
# replacing real newlines with the two characters \n
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Firebase client-side config — from Firebase project settings (safe to expose)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=vortrexyn-online-grocery-store
FIREBASE_STORAGE_BUCKET=vortrexyn-online-grocery-store.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Admin dashboard credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email — Gmail address + App Password for order confirmation emails
EMAIL_SENDER=
EMAIL_PASS=

# OpenAI — for AI-generated product images in the admin panel
OPENAI_API_KEY=

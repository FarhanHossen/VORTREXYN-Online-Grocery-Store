# Copy this file to .env and fill in your values for local development.
# In Netlify, set these as environment variables in Site configuration.

# PostgreSQL — Neon connection string (production) or local for dev
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session encryption key — any long random string
SESSION_SECRET=replace_with_a_random_secret

# Firebase client-side config (safe to expose — controlled by Firebase Security Rules)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=vortrexyn-online-grocery-store
FIREBASE_STORAGE_BUCKET=vortrexyn-online-grocery-store.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Admin dashboard credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (Gmail + App Password for order confirmation emails)
EMAIL_SENDER=
EMAIL_PASS=

# OpenAI (for AI-generated product images in admin panel)
OPENAI_API_KEY=
